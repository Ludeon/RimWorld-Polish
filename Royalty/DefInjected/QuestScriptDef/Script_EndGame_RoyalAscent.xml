<?xml version='1.0' encoding='utf-8'?>
<LanguageData>
  <!-- EN:
    <li>questName(sameQuestsCount==0)->Royal Ascent</li>
    <li>questName(sameQuestsCount>=1)->Royal [titleEnd]</li>
    <li>titleEnd->Ascension</li>
    <li>titleEnd->Ascendance</li>
    <li>titleEnd->Visitor</li>
    <li>titleEnd->Guest</li>
    <li>titleEnd->Host</li>
    <li>titleEnd->Victory</li>
  -->
  <EndGame_RoyalAscent.questNameRules.rulesStrings>
    <li>questName(sameQuestsCount==0)->Królewskie wniebowstąpienie</li>
    <li>questName(sameQuestsCount&gt;=1)->Dworska misja: [titleEnd]</li>
    <li>titleEnd->Wniebowstąpienie</li>
    <li>titleEnd->Wyniesienie</li>
    <li>titleEnd->Przybysz</li>
    <li>titleEnd->Gość</li>
    <li>titleEnd->Gospodarz</li>
    <li>titleEnd->Zwycięstwo</li>
  </EndGame_RoyalAscent.questNameRules.rulesStrings>
  <!-- EN:
    <li>questDescription->[intro]The [asker_faction_leaderTitle] of [asker_faction_name] will perform a customary visit with any Archon of his domain upon request. Invite him, satisfy his royal needs for [shuttleDelayTicks_duration], and all of you can ride the shuttle to the Imperial flotilla. You may then join the Imperial court, or escape to a new life among the stars.
\nEarning the title of Archon means completing quests to earn [asker_faction_royalFavorLabel] with [asker_faction_name]. It may take years to finally achieve the title of Archon.
\nDuring his visit, you must keep his mood above [lodgersMoodThreshold_percent]. This means providing royal perquisites like a lavish bedroom.[threatsInfo]
\nThe [asker_faction_leaderTitle] will bring four of his personal guards and place them under your command. You must house these guards, but the [asker_faction_leaderTitle] will not complain if they are killed or unhappy.
\nYou must keep the visitors at [map_definite] and not send them anywhere else. If you fail this quest or migrate, you will have another chance at it later.</li>
    <li>intro(sameQuestsCount==0)->You have learned of a way to escape this planet!\n\n</li>
    <li>intro(sameQuestsCount>=1)->You have been given another chance at royal ascent.\n\n</li>
    <li>threatsInfo(allowViolentQuests==true,priority=1)->\n\nOthers will take the opportunity to try to kill the [asker_faction_leaderTitle], and will attack with great intensity. Be prepared to defend.</li>
    <li>threatsInfo-></li>
  -->
  <EndGame_RoyalAscent.questDescriptionRules.rulesStrings>
    <li>questDescription->[intro]Przywódca frakcji [asker_faction_name] (tytuł: [asker_faction_leaderTitle]) może złożyć tradycyjną wizytę każdemu archontowi ze swojej domeny. Zaproś przywódcę, zapewnij mu warunki odpowiednie do rangi przez [shuttleDelayTicks_duration], a cała Twoja grupa będzie mogła odlecieć promem do imperialnej flotylli. Tam możecie dołączyć do dworu Imperium albo rozpocząć nowe życie wśród gwiazd.\nZdobycie tytułu archonta wymaga wykonywania zadań i gromadzenia punktów [asker_faction_royalFavorLabel] we frakcji [asker_faction_name]. Może to potrwać wiele lat.\nPodczas wizyty utrzymuj nastrój przywódcy powyżej [lodgersMoodThreshold_percent]. Potrzebne będą królewskie udogodnienia, w tym odpowiednio wystawna sypialnia.[threatsInfo]\nPrzywódca przybędzie z czterema osobistymi strażnikami, którzy znajdą się pod Twoimi rozkazami. Musisz zapewnić im zakwaterowanie, lecz ich śmierć lub niezadowolenie nie spotkają się ze skargą przywódcy.\nGoście muszą pozostać w kolonii [map_definite]. Nie można ich wysyłać do innych miejsc. Jeśli zadanie zakończy się niepowodzeniem albo opuścisz osadę, później otrzymasz kolejną szansę.</li>
    <li>intro(sameQuestsCount==0)->Odkryto sposób na ucieczkę z tej planety!\n\n</li>
    <li>intro(sameQuestsCount&gt;=1)->Pojawiła się kolejna szansa na królewskie wniebowstąpienie.\n\n</li>
    <li>threatsInfo(allowViolentQuests==true,priority=1)->\n\nWrogowie mogą wykorzystać wizytę do próby zabicia przywódcy frakcji. Spodziewaj się wyjątkowo silnych ataków i przygotuj obronę.</li>
    <li>threatsInfo-></li>
  </EndGame_RoyalAscent.questDescriptionRules.rulesStrings>
  <!-- EN: QuestScriptDef TKey texts are translated as slateRef values; original game scripts remain unchanged. -->
  <!-- EN: Quest failed: [resolvedQuestName] -->
  <EndGame_RoyalAscent.LetterLabelFactionBecameHostile.slateRef>Zadanie nieudane: [resolvedQuestName]</EndGame_RoyalAscent.LetterLabelFactionBecameHostile.slateRef>
  <!-- EN: [faction_name] became hostile to you. -->
  <EndGame_RoyalAscent.LetterTextFactionBecameHostile.slateRef>Frakcja [faction_name] stała się wobec Ciebie wroga.</EndGame_RoyalAscent.LetterTextFactionBecameHostile.slateRef>
  <!-- EN: [asker_faction_leaderTitle] arrived -->
  <EndGame_RoyalAscent.LetterLabelAskerArrived.value.slateRef>Przybycie dostojnika: [asker_faction_leaderTitle]</EndGame_RoyalAscent.LetterLabelAskerArrived.value.slateRef>
  <!-- EN: The [asker_faction_leaderTitle] of [asker_faction_name], has arrived.\n\nProtect him and satisfy his royal needs until the shuttle arrives in [shuttleDelayTicks_duration].\n\nAll of you can accompany the [asker_faction_leaderTitle] on the shuttle and travel to the Imperial flotilla to begin a new life. -->
  <EndGame_RoyalAscent.LetterTextAskerArrived.value.slateRef>Przybywa [asker_nameDef] (tytuł: [asker_faction_leaderTitle], frakcja: [asker_faction_name]).\n\nZapewnij zleceniodawcy bezpieczeństwo i wymagane udogodnienia królewskie przez [shuttleDelayTicks_duration], do czasu przybycia promu.</EndGame_RoyalAscent.LetterTextAskerArrived.value.slateRef>
  <!-- EN: Guest died: {SUBJECT_definite} -->
  <EndGame_RoyalAscent.LetterLabelGuestDied.slateRef>Śmierć gościa: {SUBJECT_definite}</EndGame_RoyalAscent.LetterLabelGuestDied.slateRef>
  <!-- EN: {SUBJECT_definite}, who you were charged to protect, has died. [failLetterEndingCommon] -->
  <EndGame_RoyalAscent.LetterTextGuestDied.slateRef>Nie żyje {SUBJECT_definite}. Nie udało się zapewnić gościowi bezpieczeństwa. [failLetterEndingCommon]</EndGame_RoyalAscent.LetterTextGuestDied.slateRef>
  <!-- EN: Should depart on shuttle -->
  <EndGame_RoyalAscent.InspectStringDepartShuttle.slateRef>Odlot promem</EndGame_RoyalAscent.InspectStringDepartShuttle.slateRef>
  <!-- EN: Shuttle arrived -->
  <EndGame_RoyalAscent.LetterLabelShuttleArrived.slateRef>Przybył prom</EndGame_RoyalAscent.LetterLabelShuttleArrived.slateRef>
  <!-- EN: The shuttle has arrived to collect the [asker_faction_leaderTitle].\n\nAll of you can accompany the [asker_faction_leaderTitle] on the shuttle and travel to the Imperial flotilla to begin a new life. -->
  <EndGame_RoyalAscent.LetterTextShuttleArrived.slateRef>Przybył prom po [asker_nameDef].\n\nMożecie wejść na pokład i udać się do imperialnej flotylli, aby rozpocząć nowe życie.</EndGame_RoyalAscent.LetterTextShuttleArrived.slateRef>
  <!-- EN: You've escaped on the Imperial shuttle! -->
  <EndGame_RoyalAscent.EndGameIntroText.slateRef>Udało się opuścić planetę na pokładzie imperialnego promu!</EndGame_RoyalAscent.EndGameIntroText.slateRef>
  <!-- EN: The high stellarch will now welcome you into the Imperial flotilla as an honored noble party.\n\nYou might stay in the Imperial court and jockey for political power. Perhaps you'll avoid the drama and focus on enjoying ultratech luxuries. Or, you might even buy a ship and set a course for your long-lost home.\n\nThe choice is up to you. -->
  <EndGame_RoyalAscent.EndGameEndingText.slateRef>Wysoki stellarcha przyjmie teraz Twoją grupę do imperialnej flotylli jako szanowanych przedstawicieli szlachty.\n\nMożecie pozostać na dworze Imperium i walczyć o wpływy polityczne. Możecie też zignorować dworskie intrygi i cieszyć się luksusami ultratechnologii. Możecie nawet kupić statek i obrać kurs na dawno utracony dom.\n\nWybór należy do Was.</EndGame_RoyalAscent.EndGameEndingText.slateRef>
  <!-- EN: {SUBJECT_bestRoyalTitle} unhappy -->
  <EndGame_RoyalAscent.LetterLabelSubjectUnhappy.slateRef>Niezadowolenie: {SUBJECT_bestRoyalTitle}</EndGame_RoyalAscent.LetterLabelSubjectUnhappy.slateRef>
  <!-- EN: {SUBJECT_definite}, who you were charged to protect and keep happy, has been below the minimum mood of [lodgersMoodThreshold] too long. [failLetterEndingCommon] -->
  <EndGame_RoyalAscent.LetterTextSubjectUnhappy.slateRef>Nastrój osoby {SUBJECT_definite}, którą należało chronić, zbyt długo pozostawał poniżej wymaganego poziomu [lodgersMoodThreshold]. [failLetterEndingCommon]</EndGame_RoyalAscent.LetterTextSubjectUnhappy.slateRef>
  <!-- EN: Guest captured: {SUBJECT_definite} -->
  <EndGame_RoyalAscent.LetterLabelGuestCaptured.slateRef>Aresztowano gościa: {SUBJECT_definite}</EndGame_RoyalAscent.LetterLabelGuestCaptured.slateRef>
  <!-- EN: {SUBJECT_definite}, who you were charged to protect, has been arrested. [failLetterEndingCommon] -->
  <EndGame_RoyalAscent.LetterTextGuestCaptured.slateRef>Aresztowano chronionego gościa. Zatrzymany: {SUBJECT_definite}. [failLetterEndingCommon]</EndGame_RoyalAscent.LetterTextGuestCaptured.slateRef>
  <!-- EN: Unauthorized surgery: {SUBJECT_definite} -->
  <EndGame_RoyalAscent.LetterLabelUnauthorizedSurgery.slateRef>Niedozwolona operacja: {SUBJECT_definite}</EndGame_RoyalAscent.LetterLabelUnauthorizedSurgery.slateRef>
  <!-- EN: Unauthorized, violating surgery has been performed on {SUBJECT_definite}, who you were charged to protect. [failLetterEndingCommon] -->
  <EndGame_RoyalAscent.LetterTextUnauthorizedSurgery.slateRef>Na osobie {SUBJECT_definite}, którą należało chronić, przeprowadzono niedozwoloną operację. [failLetterEndingCommon]</EndGame_RoyalAscent.LetterTextUnauthorizedSurgery.slateRef>
  <!-- EN: Guest lost: {SUBJECT_definite} -->
  <EndGame_RoyalAscent.LetterLabelGuestLost.slateRef>Utrata gościa: {SUBJECT_definite}</EndGame_RoyalAscent.LetterLabelGuestLost.slateRef>
  <!-- EN: {SUBJECT_definite}, who you were charged to protect, has left the assigned settlement. [failLetterEndingCommon] -->
  <EndGame_RoyalAscent.LetterTextGuestLost.slateRef>{SUBJECT_definite} {SUBJECT_gender ? opuścił : opuściła} wyznaczoną osadę. [failLetterEndingCommon]</EndGame_RoyalAscent.LetterTextGuestLost.slateRef>
  <!-- EN: Shuttle destroyed -->
  <EndGame_RoyalAscent.LetterLabelShuttleDestroyed.slateRef>Zniszczono prom</EndGame_RoyalAscent.LetterLabelShuttleDestroyed.slateRef>
  <!-- EN: The shuttle sent to collect the [asker_faction_leaderTitle] has been destroyed. [failLetterEndingCommon] -->
  <EndGame_RoyalAscent.LetterTextShuttleDestroyed.slateRef>Prom wysłany po osobę pełniącą funkcję [asker_faction_leaderTitle] został zniszczony. [failLetterEndingCommon]</EndGame_RoyalAscent.LetterTextShuttleDestroyed.slateRef>
  <!-- EN: Guest lost: {SUBJECT_definite} -->
  <EndGame_RoyalAscent.LetterLabelLodgerRanWild.slateRef>Gość zdziczał: {SUBJECT_definite}</EndGame_RoyalAscent.LetterLabelLodgerRanWild.slateRef>
  <!-- EN: {SUBJECT_definite}, who you were charged to protect, has run wild. [failLetterEndingCommon] -->
  <EndGame_RoyalAscent.LetterTextLodgerRanWild.slateRef>{SUBJECT_definite} {SUBJECT_gender ? zdziczał : zdziczała}. [failLetterEndingCommon]</EndGame_RoyalAscent.LetterTextLodgerRanWild.slateRef>
  <!-- EN: Quest failed: [resolvedQuestName] -->
  <EndGame_RoyalAscent.LetterLabelShuttleSentUnsatisfied.slateRef>Zadanie nieudane: [resolvedQuestName]</EndGame_RoyalAscent.LetterLabelShuttleSentUnsatisfied.slateRef>
  <!-- EN: The shuttle sent to collect the [asker_faction_leaderTitle] has departed without [asker_objective]. [asker_pronoun] will now leave on foot. [failLetterEndingCommon] -->
  <EndGame_RoyalAscent.LetterTextShuttleSentUnsatisfied.slateRef>Prom wysłany po [asker_nameDef] odleciał bez pasażera. Gość opuści teraz kolonię pieszo. [failLetterEndingCommon]</EndGame_RoyalAscent.LetterTextShuttleSentUnsatisfied.slateRef>
</LanguageData>
