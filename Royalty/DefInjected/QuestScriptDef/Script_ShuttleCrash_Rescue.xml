<?xml version='1.0' encoding='utf-8'?>
<LanguageData>
  <!-- EN:
    <li>failLetterEndingCommon->You have failed the quest '[resolvedQuestName]'.</li>
    <li>successLetterEndingCommon->You have succesfully completed the quest '[resolvedQuestName]'.</li>
    <li>goodwillSomeCiviliansLost->Not all the [asker_faction_pawnSingular] [pawnLabel] could be rescued. [goodwillNegativelyAffected]</li>
    <li>goodwillAllCiviliansLost->None of the [asker_faction_pawnSingular] [pawnLabelPlural] could be rescued. [goodwillNegativelyAffected]</li>
    <li>goodwillNegativelyAffected->Your goodwill with [asker_faction_name] has been negatively affected for every [pawnLabel] left.</li>
    <li>commanderLandingDesc->[asker_nameDef], the commander who asked to land [asker_possessive] shuttle at [map_definite]</li>
    <li>raidArrivedLetterLabel->Raid: [enemyFaction_name]</li>
    <li>raidArrivedLetterText->[enemyFaction_pawnsPlural] from the [enemyFaction_name] have arrived. They will attack the [asker_faction_pawnsPlural] who crashed at [map_definite].\n\nDefend the [asker_faction_pawnsPlural] until their rescue shuttle arrives in [rescueShuttleAfterRaidDelay_duration].</li>
    <li>rescueShuttleArrivedLetterLabel->Rescue shuttle arrived</li>
    <li>rescueShuttleArrivedLetterText->The rescue shuttle has arrived to collect the [pawnLabelSingleOrPlural] who crashed landed. Make sure to have these people on the shuttle before it leaves in [rescueDelay_duration]:\n\n[civilians]</li>
    <li>questCompletedSuccessLetterLabel->Quest completed: [resolvedQuestName]</li>
    <li>questCompletedSuccessLetterText->[commanderLandingDesc], has escaped. [asker_pronoun] is grateful for the help [asker_pronoun] received at [map_definite].\n\n[successLetterEndingCommon]</li>
    <li>questCompletedCiviliansLostSuccessLetterLabel->Quest completed: [resolvedQuestName]</li>
    <li>questCompletedCiviliansLostSuccessLetterText->[commanderLandingDesc], has escaped.\n\n[goodwillSomeCiviliansLost]\n\n[successLetterEndingCommon]</li>
    <li>askerLostLetterLabel->Quest failed: [resolvedQuestName]</li>
    <li>askerLostLetterText->[commanderLandingDesc] was not on board when the shuttle departed.\n\n[goodwillSomeCiviliansLost]\n\n[failLetterEndingCommon]</li>
    <li>allLostLetterLabel->Quest failed: [resolvedQuestName]</li>
    <li>allLostLetterText->The rescue shuttle for the crashed [asker_faction_pawnsPlural] has departed without anyone on board.\n\n[goodwillAllCiviliansLost]\n\n[failLetterEndingCommon]</li>
    <li>askerDiedLetterLabel->Quest failed: [resolvedQuestName]</li>
    <li>askerDiedLetterText->[commanderLandingDesc] has died.\n\n[failLetterEndingCommon]</li>
    <li>shuttleDestroyedLetterLabel->Quest failed: [resolvedQuestName]</li>
    <li>shuttleDestroyedLetterText->The shuttle sent to collect the crashed [asker_faction_pawnsPlural] has been destroyed. The [asker_faction_pawnsPlural] will now leave on foot.\n\n[failLetterEndingCommon]</li>
  -->
  <ShuttleCrash_Rescue.questContentRules.rulesStrings>
    <li>failLetterEndingCommon-&gt;Nie udało ci się wykonać zadania '[resolvedQuestName]'.</li>
    <li>successLetterEndingCommon-&gt;Udało ci się wykonać zadanie '[resolvedQuestName]'.</li>
    <li>goodwillSomeCiviliansLost-&gt;Nie udało się uratować wszystkich cywilów. [goodwillNegativelyAffected]</li>
    <li>goodwillAllCiviliansLost-&gt;Nie uratowano żadnego cywila. [goodwillNegativelyAffected]</li>
    <li>goodwillNegativelyAffected-&gt;Przychylność frakcji [asker_faction_name] spadła za każdego pozostawionego cywila.</li>
    <li>commanderLandingDesc-&gt;Dowódca promu [asker_nameDef]</li>
    <li>raidArrivedLetterLabel-&gt;Najazd: [enemyFaction_name]</li>
    <li>raidArrivedLetterText-&gt;Przybyli napastnicy frakcji [enemyFaction_name] ([enemyFaction_pawnsPlural]). Zaatakują rozbitków z frakcji [asker_faction_name] w [map_definite].\n\nBroń rozbitków do czasu przybycia promu ratowniczego za [rescueShuttleAfterRaidDelay_duration].</li>
    <li>rescueShuttleArrivedLetterLabel-&gt;Przybył prom ratowniczy</li>
    <li>rescueShuttleArrivedLetterText-&gt;Przybył prom ratowniczy, który ma zabrać rozbitków ([pawnLabelSingleOrPlural]). Dopilnuj, by następujące osoby znalazły się na pokładzie przed odlotem za [rescueDelay_duration]:\n\n[civilians]</li>
    <li>questCompletedSuccessLetterLabel-&gt;Zadanie ukończone: [resolvedQuestName]</li>
    <li>askerEvacuated(asker_gender==Male,priority=1)-&gt;został ewakuowany</li>
    <li>askerEvacuated(asker_gender==Female,priority=1)-&gt;została ewakuowana</li>
    <li>askerEvacuated-&gt;jest już bezpiecznie poza promem</li>
    <li>questCompletedSuccessLetterText-&gt;[asker_nameDef] [askerEvacuated]. Za otrzymaną pomoc zleceniodawca wyraża wdzięczność kolonii w [map_definite].\n\n[successLetterEndingCommon]</li>
    <li>questCompletedCiviliansLostSuccessLetterLabel-&gt;Zadanie ukończone: [resolvedQuestName]</li>
    <li>questCompletedCiviliansLostSuccessLetterText-&gt;Dowódcę promu [asker_nameDef] udało się ewakuować.\n\n[goodwillSomeCiviliansLost]\n\n[successLetterEndingCommon]</li>
    <li>askerLostLetterLabel-&gt;Zadanie nie powiodło się: [resolvedQuestName]</li>
    <li>askerLostLetterText-&gt;Dowódca promu [asker_nameDef] nie znalazł się na pokładzie przed odlotem.\n\n[goodwillSomeCiviliansLost]\n\n[failLetterEndingCommon]</li>
    <li>allLostLetterLabel-&gt;Zadanie nie powiodło się: [resolvedQuestName]</li>
    <li>allLostLetterText-&gt;Prom ratowniczy wysłany po [asker_faction_pawnsPlural] odleciał bez nikogo.\n\n[goodwillAllCiviliansLost]\n\n[failLetterEndingCommon]</li>
    <li>askerDiedLetterLabel-&gt;Zadanie nie powiodło się: [resolvedQuestName]</li>
    <li>askerDiedLetterText-&gt;Dowódca promu [asker_nameDef] nie żyje.\n\n[failLetterEndingCommon]</li>
    <li>shuttleDestroyedLetterLabel-&gt;Zadanie nie powiodło się: [resolvedQuestName]</li>
    <li>shuttleDestroyedLetterText-&gt;Prom wysłany po rozbitków z frakcji [asker_faction_name] został zniszczony. Ocalali opuszczą kolonię pieszo.\n\n[failLetterEndingCommon]</li>
  </ShuttleCrash_Rescue.questContentRules.rulesStrings>
  <!-- EN:
    <li>pawnLabel->civilian</li>
    <li>pawnLabelPlural->civilians</li>
  -->
  <ShuttleCrash_Rescue.questDescriptionAndNameRules.rulesStrings>
    <li>pawnLabel-&gt;cywil</li>
    <li>pawnLabelPlural-&gt;cywile</li>
  </ShuttleCrash_Rescue.questDescriptionAndNameRules.rulesStrings>
  <!-- EN:
    <li>pawnLabelSingleOrPlural(civilians_count==1)->[pawnLabel]</li>
    <li>pawnLabelSingleOrPlural(civilians_count>=2)->[pawnLabelPlural]</li>
    <li>questDescription->A shuttle of [asker_faction_name] has taken damage and is seeking a place to land. Its commander [asker_nameDef] wants to land at [map_definite].\n\n[enemyFaction_pawnsPlural] from [enemyFaction_name] will attack the crashed shuttle site in an attempt to kill its occupants. You must defend them.\n\nThe shuttle contains [asker_nameDef][andOtherCivilians] and [soldiers_count] [soldiers0_kind]s. The commander [andCivilians] must be rescued, but the [soldiers0_kind]s may be sacrificed.\n\nAfter [rescueDelay_duration], a rescue shuttle will come to pick up the survivors. You'll need to get them all on board within [leaveDelay_duration].</li>
    <li>andOtherCivilians(civilians_count==1)-></li>
    <li>andOtherCivilians(civilians_count==2)->, another [pawnLabel],</li>
    <li>andOtherCivilians(civilians_count>=3)->, [civilianCountMinusOne] other [pawnLabelSingleOrPlural],</li>
    <li>andCivilians(civilians_count==1)-></li>
    <li>andCivilians(civilians_count==2)->and [pawnLabel]</li>
    <li>andCivilians(civilians_count>=3)->and [pawnLabelPlural]</li>
  -->
  <ShuttleCrash_Rescue.questDescriptionRules.rulesStrings>
    <li>pawnLabelSingleOrPlural(civilians_count==1)-&gt;[pawnLabel]</li>
    <li>pawnLabelSingleOrPlural(civilians_count&gt;=2)-&gt;[pawnLabelPlural]</li>
    <li>questDescription-&gt;Prom frakcji [asker_faction_name] został uszkodzony i szuka bezpiecznego miejsca do lądowania. Dowódca promu [asker_nameDef] chce wylądować w [map_definite].\n\nOddziały frakcji [enemyFaction_name] ([enemyFaction_pawnsPlural]) zaatakują pasażerów, więc musisz zapewnić rozbitkom ochronę.\n\nNa pokładzie znajdują się: dowódca [asker_nameDef][andOtherCivilians] oraz [soldiers_count] żołnierzy ([soldiers0_kind]). Dowódcę [andCivilians] trzeba uratować. Śmierć żołnierzy ochrony nie spowoduje niepowodzenia zadania.\n\nZa [rescueDelay_duration] przybędzie prom ratowniczy. Rozbitkowie muszą wejść na pokład przed jego odlotem, na co będzie [leaveDelay_duration].</li>
    <li>andOtherCivilians(civilians_count==1)-&gt;</li>
    <li>andOtherCivilians(civilians_count==2)-&gt;, jeszcze jeden cywil</li>
    <li>andOtherCivilians(civilians_count&gt;=3)-&gt;, a także [civilianCountMinusOne] innych cywilów</li>
    <li>andCivilians(civilians_count==1)-&gt;</li>
    <li>andCivilians(civilians_count==2)-&gt;i jednego cywila</li>
    <li>andCivilians(civilians_count&gt;=3)-&gt;i pozostałych cywilów</li>
  </ShuttleCrash_Rescue.questDescriptionRules.rulesStrings>
