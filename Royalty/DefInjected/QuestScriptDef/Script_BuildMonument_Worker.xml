<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: Monument completed -->
  <BuildMonumentWorker.LetterLabelMonumentConstructed.slateRef>Monument ukończony</BuildMonumentWorker.LetterLabelMonumentConstructed.slateRef>
  <!-- EN: You completed construction of the monument.\n\nYou must not destroy it for at least [keepMonumentTicks_duration], otherwise you will anger [asker_factionName] ([goodwillChangeIfMonumentDestroyed] goodwill). -->
  <BuildMonumentWorker.LetterTextMonumentConstructed.slateRef>Ukończono budowę monumentu.\n\nPrzez najbliższe [keepMonumentTicks_duration] nie wolno go niszczyć. W przeciwnym razie przychylność frakcji [asker_factionName] spadnie o [goodwillChangeIfMonumentDestroyed].</BuildMonumentWorker.LetterTextMonumentConstructed.slateRef>
  <!-- EN: Monument destroyed -->
  <BuildMonumentWorker.LetterLabelMonumentRuined.slateRef>Monument został zniszczony</BuildMonumentWorker.LetterLabelMonumentRuined.slateRef>
  <!-- EN: [asker_nameDef] is offended that you allowed the monument to be ruined so soon after completion.\n\nYour relations with [asker_faction_name] have fallen by [goodwillChangeIfMonumentDestroyed]. -->
  <BuildMonumentWorker.LetterTextMonumentRuined.slateRef>Monument został zniszczony przed upływem wymaganego czasu. Wywołało to niezadowolenie zleceniodawcy [asker_nameDef].\n\nPrzychylność frakcji [asker_factionName] spadła o [goodwillChangeIfMonumentDestroyed].</BuildMonumentWorker.LetterTextMonumentRuined.slateRef>
  <!-- EN: Do not destroy the monument for {0} -->
  <BuildMonumentWorker.DontDestroyMonumentForDays.slateRef>Nie niszcz monumentu przez {0}</BuildMonumentWorker.DontDestroyMonumentForDays.slateRef>
  <!-- EN: Do not destroy the monument for {0} -->
  <BuildMonumentWorker.DontDestroyMonumentForDaysTip.slateRef>Monument musi pozostać nienaruszony przez {0}</BuildMonumentWorker.DontDestroyMonumentForDaysTip.slateRef>
  <!-- EN: Keep monument {0} -->
  <BuildMonumentWorker.KeepMonument.slateRef>Zachowaj monument przez {0}</BuildMonumentWorker.KeepMonument.slateRef>
  <!-- EN: The monument for the quest '[resolvedQuestName]' has been violated. Consequences will follow. -->
  <BuildMonumentWorker.MessageMonumentViolated.slateRef>Monument związany z zadaniem "[resolvedQuestName]" został uszkodzony. Nastąpią konsekwencje.</BuildMonumentWorker.MessageMonumentViolated.slateRef>
  <!-- EN: Protect the monument for {0} -->
  <BuildMonumentWorker.ProtectMonumentForDays.slateRef>Chroń monument przez {0}</BuildMonumentWorker.ProtectMonumentForDays.slateRef>
  <!-- EN: Protect the monument until {0} -->
  <BuildMonumentWorker.ProtectMonumentForDaysTip.slateRef>Monument musi być chroniony przez {0}</BuildMonumentWorker.ProtectMonumentForDaysTip.slateRef>
  <!-- EN: Protect for {0} -->
  <BuildMonumentWorker.ProtectMonument.slateRef>Chroń przez {0}</BuildMonumentWorker.ProtectMonument.slateRef>
  <!-- EN: New monument marker arrived -->
  <BuildMonumentWorker.LetterLabelMonumentMarkerArrived.slateRef>Przybył nowy znacznik monumentu</BuildMonumentWorker.LetterLabelMonumentMarkerArrived.slateRef>
  <!-- EN: Since the monument marker has been destroyed, a new one has been sent. -->
  <BuildMonumentWorker.LetterTextMonumentMarkerArrived.slateRef>Ponieważ poprzedni znacznik monumentu został zniszczony, dostarczono nowy.</BuildMonumentWorker.LetterTextMonumentMarkerArrived.slateRef>
  <!-- EN: Monument time expired -->
  <BuildMonumentWorker.LetterLabelTimeExpired.slateRef>Upłynął czas budowy monumentu</BuildMonumentWorker.LetterLabelTimeExpired.slateRef>
  <!-- EN: Your time limit to construct the monument has expired. [failLetterEndingCommon] -->
  <BuildMonumentWorker.LetterTextTimeExpired.slateRef>Upłynął czas przeznaczony na budowę monumentu. [failLetterEndingCommon]</BuildMonumentWorker.LetterTextTimeExpired.slateRef>
  
</LanguageData>