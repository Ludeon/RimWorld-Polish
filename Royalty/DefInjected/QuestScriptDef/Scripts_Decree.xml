<?xml version='1.0' encoding='utf-8'?>
<LanguageData>
  <!-- EN:
    <li>questDescription->[decreeIntro]\n\nYou must build a monument. It is [monumentSize] in size and will require these resources (total value [monumentRequiredResourcesMarketValue_money]):\n\n[monumentRequiredResources]\n\n[decreeThreatInfo]\n\nYou must keep the monument safe for [keepMonumentTicks_duration] after completion, otherwise [asker_nameDef] will be unhappy.</li>
  -->
  <Decree_BuildMonument.questDescriptionRules.rulesStrings>
    <li>askerDissatisfied(asker_gender==Male,priority=1)-&gt;będzie niezadowolony</li>
    <li>askerDissatisfied(asker_gender==Female,priority=1)-&gt;będzie niezadowolona</li>
    <li>askerDissatisfied-&gt;wyrazi niezadowolenie</li>
    <li>questDescription-&gt;[decreeIntro]\n\nMusisz zbudować monument o wymiarach [monumentSize]. Potrzebne materiały (łączna wartość: [monumentRequiredResourcesMarketValue_money]):\n\n[monumentRequiredResources]\n\n[decreeThreatInfo]\n\nPo ukończeniu budowy trzeba chronić monument przez [keepMonumentTicks_duration]. W przeciwnym razie [asker_nameDef] [askerDissatisfied].</li>
  </Decree_BuildMonument.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->monument decree</li>
  -->
  <Decree_BuildMonument.questNameRules.rulesStrings>
    <li>questName-&gt;Dekret budowy monumentu</li>
  </Decree_BuildMonument.questNameRules.rulesStrings>
  <!-- EN: New monument marker arrived -->
  <Decree_BuildMonument.LetterLabelNewMonumentMarkerArrived.slateRef>Przybył nowy znacznik monumentu</Decree_BuildMonument.LetterLabelNewMonumentMarkerArrived.slateRef>
  <!-- EN: Since the monument marker has been destroyed, a new one has been sent. -->
  <Decree_BuildMonument.LetterTextNewMonumentMarkerArrived.slateRef>Ponieważ znacznik monumentu został zniszczony, został przysłany nowy.</Decree_BuildMonument.LetterTextNewMonumentMarkerArrived.slateRef>
  <!-- EN: Monument completed -->
  <Decree_BuildMonument.LetterLabelMonumentCompleted.slateRef>Monument ukończony</Decree_BuildMonument.LetterLabelMonumentCompleted.slateRef>
  <!-- EN: You have completed construction of the monument.\n\nYou must keep it safe for [keepMonumentTicks_duration], otherwise [asker_nameDef] will be displeased. -->
  <Decree_BuildMonument.LetterTextMonumentCompleted.slateRef>Budowa monumentu została ukończona.\n\nTrzeba chronić go przez [keepMonumentTicks_duration], w przeciwnym razie postać [asker_nameDef] będzie niezadowolona.</Decree_BuildMonument.LetterTextMonumentCompleted.slateRef>
  <!-- EN: Monument destroyed -->
  <Decree_BuildMonument.LetterLabelMonumentDestroyed.slateRef>Monument został zniszczony</Decree_BuildMonument.LetterLabelMonumentDestroyed.slateRef>
  <!-- EN: [asker_nameDef] is offended that you allowed the monument to be ruined so soon after completion.\n\n[asker_pronoun] will be unhappy about this. -->
  <Decree_BuildMonument.LetterTextMonumentDestroyed.slateRef>Zleceniodawca [asker_nameDef] jest niezadowolony ze zniszczenia monumentu tak szybko po ukończeniu budowy. Ten incydent wpłynie na jego nastrój.</Decree_BuildMonument.LetterTextMonumentDestroyed.slateRef>
  <!-- EN: Do not destroy the monument for {0} -->
  <Decree_BuildMonument.DontDestroyMonumentForDays.slateRef>Nie niszcz monumentu przez {0}</Decree_BuildMonument.DontDestroyMonumentForDays.slateRef>
  <!-- EN: Do not destroy the monument for {0} -->
  <Decree_BuildMonument.DontDestroyMonumentForDaysTip.slateRef>Nie niszcz monumentu przez {0}</Decree_BuildMonument.DontDestroyMonumentForDaysTip.slateRef>
  <!-- EN: Keep monument {0} -->
  <Decree_BuildMonument.KeepMonument.slateRef>Zachowaj monument przez {0}</Decree_BuildMonument.KeepMonument.slateRef>
  <!-- EN:
    <li>questDescription->[decreeIntro]\n\nYou must harvest [plantToHarvest_label] x[harvestItemCount].\n\nYou may need to plant and grow the [plantToHarvest_label] first.\n\n[decreeThreatInfo]</li>
  -->
  <Decree_HarvestCrop.questDescriptionRules.rulesStrings>
    <li>questDescription-&gt;[decreeIntro]\n\nMusisz zebrać plony: [plantToHarvest_label], liczba: [harvestItemCount].\n\nMoże to wymagać wcześniejszego zasiania i uprawy roślin.\n\n[decreeThreatInfo]</li>
  </Decree_HarvestCrop.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->[plantToHarvest_label] harvest decree</li>
  -->
  <Decree_HarvestCrop.questNameRules.rulesStrings>
    <li>questName-&gt;Dekret zbiorów — [plantToHarvest_label]</li>
  </Decree_HarvestCrop.questNameRules.rulesStrings>
  <!-- EN:
    <li>questDescription->[decreeIntro]\n\nYou must hunt or slaughter [animalToHuntWithCount].\n\n[decreeThreatInfo]</li>
    <li>animalToHuntWithCount(countToHunt==1)->[animalToHunt_indefinite]</li>
    <li>animalToHuntWithCount(countToHunt!=1)->[countToHunt] [animalToHunt_labelPlural]</li>
  -->
  <Decree_HuntAnimal.questDescriptionRules.rulesStrings>
    <li>questDescription-&gt;[decreeIntro]\n\nMusisz upolować lub ubić określone zwierzęta. Cel zadania: [animalToHuntWithCount].\n\n[decreeThreatInfo]</li>
    <li>animalToHuntWithCount(countToHunt==1)-&gt;[animalToHunt_indefinite]</li>
    <li>animalToHuntWithCount(countToHunt!=1)-&gt;[countToHunt] [animalToHunt_labelPlural]</li>
  </Decree_HuntAnimal.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->[animalToHunt_label] hunting decree</li>
  -->
  <Decree_HuntAnimal.questNameRules.rulesStrings>
    <li>questName-&gt;Dekret polowania — [animalToHunt_label]</li>
  </Decree_HuntAnimal.questNameRules.rulesStrings>
  <!-- EN:
    <li>questDescription->[decreeIntro]\n\nYou must produce:\n\n - [thingToProduceLabel]\n\n[decreeThreatInfo]</li>
  -->
  <Decree_ProduceItem.questDescriptionRules.rulesStrings>
    <li>questDescription-&gt;[decreeIntro]\n\nMusisz wyprodukować:\n\n - [thingToProduceLabel]\n\n[decreeThreatInfo]</li>
  </Decree_ProduceItem.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->[defToProduce_label] production decree</li>
  -->
  <Decree_ProduceItem.questNameRules.rulesStrings>
    <li>questName-&gt;Dekret produkcyjny — [defToProduce_label]</li>
  </Decree_ProduceItem.questNameRules.rulesStrings>
</LanguageData>