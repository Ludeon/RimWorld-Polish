<LanguageData>
  <!-- EN:
    <li>helpersParagraph(helpersCount==0)-></li>
    <li>helpersParagraph(helpersCount==1)->\n\nA [helperKind_label] will be placed under your control. You will have to feed and house [helpers0_objective], but [helpers0_pronoun] may die in battle without consequence.\n\n</li>
    <li>helpersParagraph(helpersCount>=2)->\n\n[helpersCount] [helperKind_labelPlural] will be placed under your control. You will have to feed and house them, but they may die in battle without consequence.\n\n</li>
    <li>helpersArrivalLetterEnd(helpersCount==0)-></li>
    <li>helpersArrivalLetterEnd(helpersCount>=1)->\n\n[helpersCount] [helpersLabelSingOrPlural] [helpersHasHave] been sent to assist you.</li>
    <li>helpersLabelSingOrPlural(helpersCount==1)->[helperKind_label]</li>
    <li>helpersLabelSingOrPlural(helpersCount>=2)->[helperKind_labelPlural]</li>
    <li>helpersHasHave(helpersCount==1)->has</li>
    <li>helpersHasHave(helpersCount>=2)->have</li>
    <li>helpersIsAre(helpersCount==1)->is</li>
    <li>helpersIsAre(helpersCount>=2)->are</li>
  -->
  <Util_MaybeGenerateHelpers.questDescriptionRules.rulesStrings>
    <li>helpersParagraph(helpersCount==0)-></li>
    <li>helpersParagraph(helpersCount==1)->\n\nPod twoje dowództwo zostanie oddana jednostka pomocnicza: [helperKind_label]. Musisz zapewnić tej osobie wyżywienie i zakwaterowanie, ale jej śmierć w walce nie spowoduje żadnych konsekwencji.\n\n</li>
    <li>helpersParagraph(helpersCount&gt;=2)->\n\nPod twoje dowództwo zostanie oddana grupa jednostek pomocniczych: [helpersCount] [helperKind_labelPlural]. Musisz zapewnić im wyżywienie i zakwaterowanie, ale ich śmierć w walce nie spowoduje żadnych konsekwencji.\n\n</li>
    <li>helpersArrivalLetterEnd(helpersCount==0)-></li>
    <li>helpersArrivalLetterEnd(helpersCount&gt;=1)->\n\nPrzydzielone jednostki pomocnicze: [helpersCount] [helpersLabelSingOrPlural]. Wysłano je, aby ci pomogły.</li>
    <li>helpersLabelSingOrPlural(helpersCount==1)->[helperKind_label]</li>
    <li>helpersLabelSingOrPlural(helpersCount&gt;=2)->[helperKind_labelPlural]</li>
    <li>helpersHasHave(helpersCount==1)->został wysłany</li>
    <li>helpersHasHave(helpersCount&gt;=2)->zostali wysłani</li>
    <li>helpersIsAre(helpersCount==1)->odchodzi</li>
    <li>helpersIsAre(helpersCount&gt;=2)->odchodzą</li>
  </Util_MaybeGenerateHelpers.questDescriptionRules.rulesStrings>
  <!-- EN: [helpersLabelSingOrPlural] arrived -->
  <Util_MaybeGenerateHelpers.LetterLabelHelpersArrived.value.slateRef>Przybyły jednostki pomocnicze: [helpersLabelSingOrPlural]</Util_MaybeGenerateHelpers.LetterLabelHelpersArrived.value.slateRef>
  <!-- EN: The [helpersLabelSingOrPlural] sent by [asker_nameDef] [helpersHasHave] arrived to aid you with the quest '[resolvedQuestName]'. -->
  <Util_MaybeGenerateHelpers.LetterTextHelpersArrived.value.slateRef>Do pomocy przy zadaniu "[resolvedQuestName]" przybyły jednostki wysłane przez zleceniodawcę [asker_nameDef]. Typ jednostek: [helpersLabelSingOrPlural].</Util_MaybeGenerateHelpers.LetterTextHelpersArrived.value.slateRef>
  <!-- EN: the [helpersLabelSingOrPlural] -->
  <Util_MaybeGenerateHelpers.ArrivingPawnsLabelDefinite.value.slateRef>[helpersLabelSingOrPlural]</Util_MaybeGenerateHelpers.ArrivingPawnsLabelDefinite.value.slateRef>
  <!-- EN: [helpersLabelSingOrPlural] leaving -->
  <Util_MaybeGenerateHelpers.LetterLabelHelpersLeaving.slateRef>Jednostki pomocnicze odchodzą: [helpersLabelSingOrPlural]</Util_MaybeGenerateHelpers.LetterLabelHelpersLeaving.slateRef>
  <!-- EN: The [helpersLabelSingOrPlural] sent by [asker_nameDef] to aid you [helpersHasHave] spent too much time with you, and [helpersIsAre] now leaving. -->
  <Util_MaybeGenerateHelpers.LetterTextHelpersLeaving.slateRef>Jednostki pomocnicze wysłane przez zleceniodawcę [asker_nameDef] przebywały w kolonii zbyt długo i teraz odchodzą. Typ jednostek: [helpersLabelSingOrPlural].</Util_MaybeGenerateHelpers.LetterTextHelpersLeaving.slateRef>
</LanguageData>
