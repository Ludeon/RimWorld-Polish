<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>

  <!-- Entities -->
  <!-- EN: {0_definite}'s activity is rising due to taking damage. -->
  <MessageActivityRisingDamage>{0_definite} ożywia się z powodu otrzymanych obrażeń.</MessageActivityRisingDamage>
  <!-- EN: {0_definite} has died on a holding platform. -->
  <EntityDiedOnHoldingPlatform>{0_labelShort} umiera na platformie do przetrzymywania</EntityDiedOnHoldingPlatform>
  <!-- EN: New entity discovered -->
  <MessageEntityDiscovered>Odkryto nową istotę</MessageEntityDiscovered>

  <!-- Hate chanters -->
  <!-- EN: The cultists are in a trance and don't respond when attacked. -->
  <MessageHateChantersAbsorbed>Kultyści są w transie i nie reagują na ataki.</MessageHateChantersAbsorbed>
  <!-- EN: The hate chanting has increased in volume. -->
  <MessageHateChantIncreased>Nienawistny śpiew staje się coraz głośniejszy.</MessageHateChantIncreased>

  <!-- Self-resurrection -->
  <!-- EN: {0_nameDef} can self-resurrect on command using death refusal. -->
  <SelfResurrectText>{0_nameDef} może zmartwychwstać na żądanie, odmawiając śmierci.</SelfResurrectText>
  <!-- EN: {0_nameDef} is using death refusal to self-resurrect. -->
  <MessageUsingSelfResurrection>{0_nameDef} wykorzystuje odmowę śmierci do samowskrzeszenia.</MessageUsingSelfResurrection>

  <!-- Pit Gate -->
  <!-- EN: The pit gate has collapsed. -->
  <MessagePitGateCollapsed>Brama do wykopu zawaliła się.</MessagePitGateCollapsed>
  <!-- EN: A pit burrow has collapsed. -->
  <MessagePitBurrowCollapsed>Nora zawaliła się.</MessagePitBurrowCollapsed>

  <!-- Fleshsack -->
  <!-- EN: The flesh sack contained something -->
  <FleshmassContainedMessage>Worek mięsa coś zawiera.</FleshmassContainedMessage>

  <!-- Psychic rituals -->
  <!-- EN: {0_pawnsPluralDef} are attacking! -->
  <MessagePsychicRitualAssault>{0_pawnsPluralDef} atakują!</MessagePsychicRitualAssault>
  <!-- EN: {FACTION_pawnsPluralDef} are beginning the psychic ritual -->
  <MessageAIPsychicRitualBegan>{FACTION_pawnsPluralDef} rozpoczynają rytuał psi.</MessageAIPsychicRitualBegan>
  
  <!-- Biomutation lance -->
  <!-- EN: Cannot target: {0_nameDef} is not an animal or human. -->
  <MessageBiomutationLanceInvalidTargetRace>Nie może być celem: {0_nameDef} nie jest zwierzęciem ani człowiekiem.</MessageBiomutationLanceInvalidTargetRace>
  <!-- EN: Cannot target: {0_nameDef} is too large. -->
  <MessageBiomutationLanceTargetTooBig>Nie może być celem: {0_nameDef} ma za duże rozmiary.</MessageBiomutationLanceTargetTooBig>

  <!-- Containment -->
  <!-- EN: Warning: No rooms have the minimum containment strength for {0}. It may escape soon. -->
  <MessageNoRoomWithMinimumContainmentStrength>Ostrzeżenie: żadne z pomieszczeń nie ma minimalnej siły uwięzienia i {0} wkrótce ucieknie.</MessageNoRoomWithMinimumContainmentStrength>
  <!-- EN: Warning: {0} is below minimum containment strength for {1}. It may escape soon. -->
  <MessageTargetBelowMinimumContainmentStrength>Ostrzeżenie: {0} nie ma minimalnej siły uwięzienia i {1} wkrótce ucieknie.</MessageTargetBelowMinimumContainmentStrength>
  <!-- EN: Can't transfer to {0} reserved by someone else. -->
  <MessageHolderReserved>Nie można przenieść. {0} zarezerwowano dla kogoś innego.</MessageHolderReserved>
  <!-- EN: {EXECUTIONER_labelShort} has executed {VICTIM_kindIndef}. -->
  <MessageEntityExecuted>{EXECUTIONER_labelShort} przeprowadza egzekucję, {VICTIM_kindIndef} ginie.</MessageEntityExecuted>
  <!-- EN: Warning: Reinstalling an occupied holding platform will release the entity. Transfer the entity to another platform first. -->
  <MessageOccupiedHoldingPlatformReinstalled>Ostrzeżenie: Ponowna instalacja zajętej platformy do przetrzymywania doprowadzi do wypuszczenia istoty. Najpierw należy przenieść istotę na inną platformę.</MessageOccupiedHoldingPlatformReinstalled>
  <!-- EN: Warning: Uninstalling an occupied holding platform will release the entity. Transfer the entity to another platform first. -->
  <MessageOccupiedHoldingPlatformUninstalled>Ostrzeżenie: Odinstalowanie zajętej platformy do przetrzymywania doprowadzi do wypuszczenia istoty. Najpierw należy przenieść istotę na inną platformę.</MessageOccupiedHoldingPlatformUninstalled>
  <!-- EN: Warning: Deconstructing an occupied holding platform will release the entity. Transfer the entity to another platform first. -->
  <MessageOccupiedHoldingPlatformDeconstructed>Ostrzeżenie: Rozbiórka zajętej platformy do przetrzymywania doprowadzi do wypuszczenia istoty. Najpierw należy przenieść istotę na inną platformę.</MessageOccupiedHoldingPlatformDeconstructed>
  
  <!-- Duplicator obelisk -->
  <!-- EN: A hostile duplicate of {0_nameDef} has appeared. -->
  <MessageHostileDuplicate>Pojawia się wrogi duplikat istoty – {0_nameDef}.</MessageHostileDuplicate>
  
  <!-- Proximity detector -->
  <!-- EN: A proximity detector has detected an invisible creature. -->
  <MessageProximityDetectorTriggered>Czujnik zbliżeniowy wykrył niewidzialną istotę.</MessageProximityDetectorTriggered>
  
  <!-- Unnatural darkness --> 
  <!-- EN: Something in the darkness has attacked {0_nameDef}. -->
  <MessagePawnAttackedInDarkness>{0_nameDef} jest ofiarą ataku czegoś ukrytego w ciemności.</MessagePawnAttackedInDarkness>
  
  <!-- Revenant -->
  <!-- EN: A hidden revenant has been revealed! -->
  <MessageRevenantForcedVisibility>Ukryty upiór stał się widoczny!</MessageRevenantForcedVisibility>
  <!-- EN: {PAWN_nameDef} can hear the revenant {1} nearby! -->
  <MessageRevenantHeard>{PAWN_nameDef} słyszy upiora {1} w pobliżu!</MessageRevenantHeard>
  
  <!-- Abilities -->
  <!-- EN: {ABILITY_label} cannot be used on non-bleeding creatures. -->
  <MessageCannotUseOnNonBleeder>nie można użyć umiejętności {ABILITY_label} na niekrwawiących stworach.</MessageCannotUseOnNonBleeder>
  
  <!-- EN: {WAKER_nameDef} has disturbed a fingerspike. -->
  <MessageFingerspikeDisturbed>{WAKER_nameDef} pobudza palcokolec.</MessageFingerspikeDisturbed>
  <!-- EN: {WAKER_nameDef} has disturbed several fingerspikes. -->
  <MessageFingerspikeDisturbedPlural>{WAKER_nameDef} pobudza kilka palcokolców.</MessageFingerspikeDisturbedPlural>

  <!-- EN: The death pall has begun to resurrect corpses. -->
  <DeathPallResurrectedMessage>Całun śmierci ożywia: {0_indefinite}.</DeathPallResurrectedMessage>
  
  <!-- UNUSED -->
  <AbilityCannotCastHoraxian>{0_nameDef} nie traci pewności.</AbilityCannotCastHoraxian>

</LanguageData>