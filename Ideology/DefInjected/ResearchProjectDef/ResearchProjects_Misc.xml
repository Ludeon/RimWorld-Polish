<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: bioregeneration -->
  <Bioregeneration.label>bioregeneracja</Bioregeneration.label>
  <!-- EN: Unlock the biosculpter pod's bioregeneration cycle. This cycle heals old scars, regenerates small lost body parts like fingers and toes, and cures many of the physical maladies that come with old age. -->
  <Bioregeneration.description>Odblokuj cykl bioregeneracji w kapsule biorzeźbiarza. Ten cykl leczy stare blizny, regeneruje utracone małe części ciała, takie jak palce u rąk i nóg, oraz leczy wiele fizycznych dolegliwości, które pojawiają się wraz z wiekiem.</Bioregeneration.description>
  <!-- EN:
    <li>subject->bioregeneration</li>
    <li>subject_story->studied Boomalope antler regrowth for parallels with human regeneration</li>
    <li>subject_story->spliced salamander genetic data into [ANYPAWN_possessive] own body</li>
    <li>subject_story->trained in a Glitterworld hospital</li>
    <li>subject_story->completed a correspondence course in Glitterworld aesthetics</li>
    <li>subject_gerund->regenerating the human form</li>
    <li>subject_gerund->activating regeneration with biosculpters</li>
  -->
  <Bioregeneration.generalRules.rulesStrings>
    <!-- EN: subject->bioregeneration -->
    <li>subject->bioregeneracja</li>
    <!-- EN: subject_story->studied Boomalope antler regrowth for parallels with human regeneration -->
    <li>subject_story->bada odrastanie poroża bumalop pod kątem podobieństw do regeneracji ludzkich tkanek</li>
    <!-- EN: subject_story->spliced salamander genetic data into [ANYPAWN_possessive] own body -->
    <li>subject_story->wprowadza geny salamandry do [ANYPAWN_possessive] własnego organizmu</li>
    <!-- EN: subject_story->trained in a Glitterworld hospital -->
    <li>subject_story->odbywa szkolenie w szpitalu na ultratechnologicznym świecie</li>
    <!-- EN: subject_story->completed a correspondence course in Glitterworld aesthetics -->
    <li>subject_story->kończy korespondencyjny kurs estetyki ultratechnologicznej</li>
    <!-- EN: subject_gerund->regenerating the human form -->
    <li>subject_gerund->regenerowanie ludzkiego ciała</li>
    <!-- EN: subject_gerund->activating regeneration with biosculpters -->
    <li>subject_gerund->wywoływanie regeneracji za pomocą biorzeźbiarzy</li>
  </Bioregeneration.generalRules.rulesStrings>
  
  <!-- EN: biosculpting -->
  <Biosculpting.label>biorzeźbienie</Biosculpting.label>
  <!-- EN: Construct biosculpter pods which can perform various biological alterations to colonists. These are especially important to believers in transhumanism. -->
  <Biosculpting.description>Zbuduj kapsuły biorzeźbiarskie, które mogą dokonywać różnych zmian biologicznych kolonistom. Są one szczególnie ważne dla wyznawców transhumanizmu.</Biosculpting.description>
  <!-- EN:
    <li>subject->biosculpting</li>
    <li>subject_story->constructed biosculpter pods on contract for various colonies</li>
    <li>subject_story->studied transhumanist precepts, including the necessity of biosculpture</li>
    <li>subject_story->researched which biological alterations could be made safely</li>
    <li>subject_story->escaped a glitterworld support farm with these plans</li>
    <li>subject_story->was welcomed into a transhumanist colony</li>
    <li>subject_gerund->constructing biosculpter pods</li>
    <li>subject_gerund->sculpting the human form</li>
  -->
  <Biosculpting.generalRules.rulesStrings>
    <!-- EN: subject->biosculpting -->
    <li>subject->biorzeźbienie</li>
    <!-- EN: subject_story->constructed biosculpter pods on contract for various colonies -->
    <li>subject_story->buduje na zamówienie kapsuły biorzeźbiarskie dla różnych kolonii</li>
    <!-- EN: subject_story->studied transhumanist precepts, including the necessity of biosculpture -->
    <li>subject_story->zgłębia zasady transhumanizmu, w tym konieczność biorzeźbienia</li>
    <!-- EN: subject_story->researched which biological alterations could be made safely -->
    <li>subject_story->bada, które zmiany biologiczne można przeprowadzać bezpiecznie</li>
    <!-- EN: subject_story->escaped a glitterworld support farm with these plans -->
    <li>subject_story->ucieka z gospodarstwa pomocniczego na ultratechnologicznym świecie, zabierając te plany</li>
    <!-- EN: subject_story->was welcomed into a transhumanist colony -->
    <li>subject_story->otrzymuje gościnę w kolonii transhumanistów</li>
    <!-- EN: subject_gerund->constructing biosculpter pods -->
    <li>subject_gerund->budowa kapsuł biorzeźbiarskich</li>
    <!-- EN: subject_gerund->sculpting the human form -->
    <li>subject_gerund->kształtowanie ludzkiego ciała</li>
  </Biosculpting.generalRules.rulesStrings>
  
  <!-- EN: neural supercharger -->
  <NeuralSupercharger.label>doładowanie neuronów</NeuralSupercharger.label>
  <!-- EN: Construct neural supercharger devices. Neural superchargers improve consciousness and learning rate, but they also increase hunger and the effect must be refreshed daily. Transhumanists often hold neural supercharging as an important practice. -->
  <NeuralSupercharger.description>Zbuduj urządzenia doładowujące neurony. Doładowania neuronowe poprawiają świadomość i szybkość uczenia się, ale także zwiększają głód. Efekt trzeba codziennie odświeżać. Transhumaniści często uważają doładowanie neuronowe za ważną praktykę.</NeuralSupercharger.description>
  <!-- EN:
    <li>subject->neural superchargers</li>
    <li>subject_story->implemented neural superchargers in [ANYPAWN_possessive] boarding school</li>
    <li>subject_story->supercharged the neurons of farmed clones to massively accelerate their development</li>
    <li>subject_story->attempted to ban neural supercharging in the university course [ANYPAWN_pronoun] taught</li>
    <li>subject_story->joined a transhumanist sect where neural supercharging was mandatory</li>
    <li>subject_gerund->supercharging a human's intellect</li>
    <li>subject_gerund->constructing neural superchargers</li>
  -->
  <NeuralSupercharger.generalRules.rulesStrings>
    <!-- EN: subject->neural superchargers -->
    <li>subject->neuronowe doładowywacze</li>
    <!-- EN: subject_story->implemented neural superchargers in [ANYPAWN_possessive] boarding school -->
    <li>subject_story->instaluje neuronowe doładowywacze w [ANYPAWN_possessive] szkole z internatem</li>
    <!-- EN: subject_story->supercharged the neurons of farmed clones to massively accelerate their development -->
    <li>subject_story->doładowuje neurony klonów hodowlanych, aby radykalnie przyspieszyć ich rozwój</li>
    <!-- EN: subject_story->attempted to ban neural supercharging in the university course [ANYPAWN_pronoun] taught -->
    <li>subject_story->próbuje zakazać neuronowego doładowywania w ramach kursu uniwersyteckiego, który [ANYPAWN_pronoun] prowadzi</li>
    <!-- EN: subject_story->joined a transhumanist sect where neural supercharging was mandatory -->
    <li>subject_story->dołącza do sekty transhumanistów, w której neuronowe doładowywanie jest obowiązkowe</li>
    <!-- EN: subject_gerund->supercharging a human's intellect -->
    <li>subject_gerund->zwiększanie ludzkich zdolności intelektualnych przez doładowywanie neuronów</li>
    <!-- EN: subject_gerund->constructing neural superchargers -->
    <li>subject_gerund->budowa neuronowych doładowywaczy</li>
  </NeuralSupercharger.generalRules.rulesStrings>
  
</LanguageData>