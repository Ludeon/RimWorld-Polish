<LanguageData>
  <!-- EN:
    <li>helpersParagraph(helpersCount==0)-></li>
    <li>helpersParagraph(helpersCount==1)->\n\nA [helperKind_label] will be placed under your control. You will have to feed and house [helpers0_objective], but [helpers0_pronoun] may die in battle without consequence.\n\n</li>
    <li>helpersParagraph(helpersCount>=2)->\n\n[helpersCount] [helperKind_labelPlural] will be placed under your control. You will have to feed and house them, but they may die in battle without consequence.\n\n</li>
    <li>helpersArrivalLetterEnd(helpersCount==0)-></li>
    <li>helpersArrivalLetterEnd(helpersCount>=1)->\n\n[helpersCount] [helpersLabelSingOrPlural] [helpersHasHave] been sent to assist you.</li>
    <li>helpersLabelSingOrPlural(helpersCount==1)->[helperKind_label]</li>
    <li>helpersLabelSingOrPlural(helpersCount>=2)->[helperKind_labelPlural]</li>
    <li>helpersHasHave(helpersCount==1)->has</li>
    <li>helpersHasHave(helpersCount>=2)->have</li>
    <li>helpersIsAre(helpersCount==1)->is</li>
    <li>helpersIsAre(helpersCount>=2)->are</li>
  -->
  <Util_MaybeGenerateHelpers.questDescriptionRules.rulesStrings>
    <li>helpersParagraph(helpersCount==0)-></li>
    <li>helpersParagraph(helpersCount==1)->\n\nOtrzymasz pod swoją kontrolę jedną osobę do pomocy (rola: [helperKind_label]). Musisz zapewnić jej wyżywienie i zakwaterowanie. Jeżeli zginie w walce, nie poniesiesz z tego powodu konsekwencji.\n\n</li>
    <li>helpersParagraph(helpersCount>=2)->\n\nOtrzymasz pod swoją kontrolę [helpersCount] pomocników (typ: [helperKind_labelPlural]). Musisz zapewnić im wyżywienie i zakwaterowanie. Ich śmierć w walce nie pociągnie za sobą konsekwencji.\n\n</li>
    <li>helpersArrivalLetterEnd(helpersCount==0)-></li>
    <li>helpersArrivalLetterEnd(helpersCount>=1)->\n\nPrzybyła pomoc: [helpersCount] ([helpersLabelSingOrPlural]).</li>
    <li>helpersLabelSingOrPlural(helpersCount==1)->[helperKind_label]</li>
    <li>helpersLabelSingOrPlural(helpersCount>=2)->[helperKind_labelPlural]</li>
    <li>helpersHasHave(helpersCount==1)->przybywa</li>
    <li>helpersHasHave(helpersCount>=2)->przybywają</li>
    <li>helpersIsAre(helpersCount==1)->teraz odchodzi</li>
    <li>helpersIsAre(helpersCount>=2)->teraz odchodzą</li>
    <li>formaPlecPL_1(joiner_gender==Male,priority=1)->[helperKind_label]</li>
    <li>formaPlecPL_1(joiner_gender==Female,priority=1)->[helperKind_label]</li>
    <li>formaPlecPL_1->[helperKind_label]</li>
    <li>formaPlecPL_2(helpers0_gender==Male,priority=1)->[helperKind_label]</li>
    <li>formaPlecPL_2(helpers0_gender==Female,priority=1)->[helperKind_label]</li>
    <li>formaPlecPL_2->[helperKind_label]</li>
  </Util_MaybeGenerateHelpers.questDescriptionRules.rulesStrings>
  <!-- EN: [helpersLabelSingOrPlural] arrived -->
  <Util_MaybeGenerateHelpers.LetterLabelHelpersArrived.value.slateRef>Przybycie: [helpersLabelSingOrPlural]</Util_MaybeGenerateHelpers.LetterLabelHelpersArrived.value.slateRef>
  <!-- EN: The [helpersLabelSingOrPlural] sent by [asker_nameDef] [helpersHasHave] arrived to aid you with the quest '[resolvedQuestName]'. -->
  <Util_MaybeGenerateHelpers.LetterTextHelpersArrived.value.slateRef>Pomoc do zadania "[resolvedQuestName]" przybyła na miejsce. Zleceniodawca: [asker_nameDef]. Liczba pomocników: [helpersCount].</Util_MaybeGenerateHelpers.LetterTextHelpersArrived.value.slateRef>
  <!-- EN: the [helpersLabelSingOrPlural] -->
  <Util_MaybeGenerateHelpers.ArrivingPawnsLabelDefinite.value.slateRef>[helpersLabelSingOrPlural]</Util_MaybeGenerateHelpers.ArrivingPawnsLabelDefinite.value.slateRef>
  <!-- EN: [helpersLabelSingOrPlural] leaving -->
  <Util_MaybeGenerateHelpers.LetterLabelHelpersLeaving.slateRef>Odejście: [helpersLabelSingOrPlural]</Util_MaybeGenerateHelpers.LetterLabelHelpersLeaving.slateRef>
  <!-- EN: The [helpersLabelSingOrPlural] sent by [asker_nameDef] to aid you [helpersHasHave] spent too much time with you, and [helpersIsAre] now leaving. -->
  <Util_MaybeGenerateHelpers.LetterTextHelpersLeaving.slateRef>Pomocnicy przebywają tu już zbyt długo i opuszczają kolonię. Zleceniodawca: [asker_nameDef].</Util_MaybeGenerateHelpers.LetterTextHelpersLeaving.slateRef>
</LanguageData>
