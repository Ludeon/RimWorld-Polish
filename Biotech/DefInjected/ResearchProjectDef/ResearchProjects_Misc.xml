<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: archogenetics -->
  <Archogenetics.label>archogenetyka</Archogenetics.label>
  <!-- EN: Allows a gene assembler to use archite capsules to create seemingly impossible genes. Archite genes and archite capsules can be obtained from traders. -->
  <Archogenetics.description>Umożliwia monterowi genów używać architowych kapsułek do tworzenia pozornie niemożliwych genów. Geny architowe i kapsułki architowe można zdobyć od handlarzy.</Archogenetics.description>
  <!-- EN:
    <li>subject->archogenetics</li>
    <li>subject_story->excavated archite genes from the transcendent moon of Ix</li>
    <li>subject_story->made a good living as an archite gene trader</li>
    <li>subject_story->led a research expedition to an ancient monolith and returned changed</li>
    <li>subject_gerund->assembling archite genes</li>
    <li>subject_gerund->creating seemingly impossible genes</li>
  -->
  <Archogenetics.generalRules.rulesStrings>
    <!-- EN: subject->archogenetics -->
    <li>subject->archogenetyka</li>
    <!-- EN: subject_story->excavated archite genes from the transcendent moon of Ix -->
    <li>subject_story->wydobywa geny architowe na transcendentnym księżycu Ix</li>
    <!-- EN: subject_story->made a good living as an archite gene trader -->
    <li>subject_story->zarabia na życie handlem genami architowymi</li>
    <!-- EN: subject_story->led a research expedition to an ancient monolith and returned changed -->
    <li>subject_story->prowadzi wyprawę badawczą do starożytnego monolitu i wraca z niej w odmienionym stanie</li>
    <!-- EN: subject_gerund->assembling archite genes -->
    <li>subject_gerund->łączenie genów architowych</li>
    <!-- EN: subject_gerund->creating seemingly impossible genes -->
    <li>subject_gerund->projektowanie genów, których istnienie wydaje się niemożliwe</li>
  </Archogenetics.generalRules.rulesStrings>
  
  <!-- EN: deathrest -->
  <Deathrest.label>anabioza</Deathrest.label>
  <!-- EN: Those with the deathrest gene must periodically undergo a special deathrest coma that lasts several days. This research project allows you to construct buildings which accelerate the deathrest coma and confer specific bonuses on the deathrester. Over time, you can build a grand deathrest temple. -->
  <Deathrest.description>Osoby z genem anabiozy muszą okresowo zapadać w kilkudniową śpiączkę regeneracyjną zwaną anabiozą. To badanie pozwala budować urządzenia, które skracają czas anabiozy i zapewniają dodatkowe premie. Z czasem można stworzyć okazałą świątynię anabiozy.</Deathrest.description>
  <!-- EN:
    <li>subject->deathrest</li>
    <li>subject_story->dissected corpses from a deathrest temple, finally understanding how it worked</li>
    <li>subject_story->interviewed a celebrity who never seemed to age, eventually learning her secrets</li>
    <li>subject_story->attempted to replicate the technology and fell into a coma, only to wake weeks later</li>
    <li>subject_gerund->constructing deathrest facilities</li>
    <li>subject_gerund->improving deathrest</li>
  -->
  <Deathrest.generalRules.rulesStrings>
    <!-- EN: subject->deathrest -->
    <li>subject->anabioza</li>
    <!-- EN: subject_story->dissected corpses from a deathrest temple, finally understanding how it worked -->
    <li>subject_story->przeprowadza sekcje zwłok w świątyni anabiozy i w końcu poznaje zasadę jej działania</li>
    <!-- EN: subject_story->interviewed a celebrity who never seemed to age, eventually learning her secrets -->
    <li>subject_story->przeprowadza wywiad ze sławną kobietą, która zdaje się wcale nie starzeć, i odkrywa jej tajemnice</li>
    <!-- EN: subject_story->attempted to replicate the technology and fell into a coma, only to wake weeks later -->
    <li>subject_story->próbuje odtworzyć technologię anabiozy, zapada w śpiączkę i budzi się po kilku tygodniach</li>
    <!-- EN: subject_gerund->constructing deathrest facilities -->
    <li>subject_gerund->budowa urządzeń do anabiozy</li>
    <!-- EN: subject_gerund->improving deathrest -->
    <li>subject_gerund->udoskonalanie anabiozy</li>
  </Deathrest.generalRules.rulesStrings>
  
  <!-- EN: fertility procedures -->
  <FertilityProcedures.label>procedury dotyczące płodności</FertilityProcedures.label>
  <!-- EN: Perform the surgeries necessary to create a test tube embryo from a fertile man and woman, then implant the embryo in a surrogate mother or growth vat. Also, perform sterilization surgeries on men and women. -->
  <FertilityProcedures.description>Wykonaj operacje niezbędne do stworzenia embrionu z probówki, pochodzącego od płodnego mężczyzny i kobiety, a następnie wszczep go matce zastępczej lub umieść w komorze wzrostu. Możesz wykonać także zabieg sterylizacji u mężczyzn i kobiet.</FertilityProcedures.description>
  <!-- EN:
    <li>subject->fertility procedures</li>
    <li>subject_story->helped families in the coreworlds achieve their dream of parenthood with test-tube embryos</li>
    <li>subject_story->saved the rare Callopian boomrat from extinction with dangerous hand-fertilization techniques</li>
    <li>subject_story->solved the population crisis on an urbworld with fertility interventions and growth vats</li>
    <li>subject_gerund->altering human fertility</li>
    <li>subject_gerund->improving or blocking human fertility</li>
  -->
  <FertilityProcedures.generalRules.rulesStrings>
    <!-- EN: subject->fertility procedures -->
    <li>subject->procedury wspomagania płodności</li>
    <!-- EN: subject_story->helped families in the coreworlds achieve their dream of parenthood with test-tube embryos -->
    <li>subject_story->pomaga rodzinom ze światów centralnych spełnić marzenie o rodzicielstwie dzięki zarodkom z probówki</li>
    <!-- EN: subject_story->saved the rare Callopian boomrat from extinction with dangerous hand-fertilization techniques -->
    <li>subject_story->ratuje rzadki gatunek bumoszczura z Kallopii przed wyginięciem dzięki ryzykownym metodom ręcznego zapłodnienia</li>
    <!-- EN: subject_story->solved the population crisis on an urbworld with fertility interventions and growth vats -->
    <li>subject_story->rozwiązuje kryzys demograficzny na świecie miejskim dzięki zabiegom wspomagania płodności i komorom wzrostu</li>
    <!-- EN: subject_gerund->altering human fertility -->
    <li>subject_gerund->modyfikowanie ludzkiej płodności</li>
    <!-- EN: subject_gerund->improving or blocking human fertility -->
    <li>subject_gerund->zwiększanie lub ograniczanie ludzkiej płodności</li>
  </FertilityProcedures.generalRules.rulesStrings>
  
  <!-- EN: gene processor -->
  <GeneProcessor.label>procesor genów</GeneProcessor.label>
  <!-- EN: Build gene processors, which allow a gene assembler to create xenogerms of higher genetic complexity. -->
  <GeneProcessor.description>Buduj procesory genów, które umożliwiają monterowi genów tworzyć ksenogeny o większej złożoności genetycznej.</GeneProcessor.description>
  <!-- EN:
    <li>subject->gene processors</li>
    <li>subject_story->extracted Glitterworld genes from a drifting derelict</li>
    <li>subject_story->processed an entire village to create one set of higher genes</li>
    <li>subject_story->began the slow process of uplift by implanting xenogerms into a primitive tribe</li>
    <li>subject_gerund->constructing gene processors</li>
    <li>subject_gerund->processing genes</li>
  -->
  <GeneProcessor.generalRules.rulesStrings>
    <!-- EN: subject->gene processors -->
    <li>subject->procesory genów</li>
    <!-- EN: subject_story->extracted Glitterworld genes from a drifting derelict -->
    <li>subject_story->pozyskuje geny z ultratechnologicznego świata z dryfującego wraku statku</li>
    <!-- EN: subject_story->processed an entire village to create one set of higher genes -->
    <li>subject_story->poddaje całą wioskę zabiegom genetycznym, aby uzyskać jeden zestaw ulepszonych genów</li>
    <!-- EN: subject_story->began the slow process of uplift by implanting xenogerms into a primitive tribe -->
    <li>subject_story->rozpoczyna powolny proces genetycznego udoskonalania prymitywnego plemienia przez wszczepianie ksenogenów</li>
    <!-- EN: subject_gerund->constructing gene processors -->
    <li>subject_gerund->budowa procesorów genów</li>
    <!-- EN: subject_gerund->processing genes -->
    <li>subject_gerund->przetwarzanie genów</li>
  </GeneProcessor.generalRules.rulesStrings>
  
  <!-- EN: growth vats -->
  <GrowthVats.label>komora wzrostu</GrowthVats.label>
  <!-- EN: Construct growth vats which can gestate an embryo or accelerate a child's growth. -->
  <GrowthVats.description>Zbuduj komory wzrostu, w których może zainstalować embrion lub przyspieszyć rozwój dziecka.</GrowthVats.description>
  <!-- EN:
    <li>subject->advanced gestation</li>
    <li>subject->artificial wombs</li>
    <li>subject_story->ran a cloning facility to supply servants for the coreworlds</li>
    <li>subject_story->created a new army for a warworld junta</li>
    <li>subject_story->helped families of all backgrounds have children</li>
    <li>subject_gerund->gestating embryos in artificial wombs</li>
    <li>subject_gerund->accelerating human growth</li>
    <li>subject_gerund->constructing growth vats</li>
  -->
  <GrowthVats.generalRules.rulesStrings>
    <!-- EN: subject->advanced gestation -->
    <li>subject->zaawansowane metody ciąży</li>
    <!-- EN: subject->artificial wombs -->
    <li>subject->sztuczne macice</li>
    <!-- EN: subject_story->ran a cloning facility to supply servants for the coreworlds -->
    <li>subject_story->prowadzi ośrodek klonowania dostarczający służbę na światy centralne</li>
    <!-- EN: subject_story->created a new army for a warworld junta -->
    <li>subject_story->tworzy nową armię dla junty rządzącej światem wojennym</li>
    <!-- EN: subject_story->helped families of all backgrounds have children -->
    <li>subject_story->pomaga rodzinom o różnym pochodzeniu mieć dzieci</li>
    <!-- EN: subject_gerund->gestating embryos in artificial wombs -->
    <li>subject_gerund->rozwój zarodków w sztucznych macicach</li>
    <!-- EN: subject_gerund->accelerating human growth -->
    <li>subject_gerund->przyspieszanie rozwoju człowieka</li>
    <!-- EN: subject_gerund->constructing growth vats -->
    <li>subject_gerund->budowa komór wzrostu</li>
  </GrowthVats.generalRules.rulesStrings>
  
  <!-- EN: toxin filtration -->
  <ToxFiltration.label>filtracja toksyn</ToxFiltration.label>
  <!-- EN: Craft and install bionic organs that can filter out toxins from the environment and from enemy attacks. -->
  <ToxFiltration.description>Stwórz i zainstaluj bioniczne organy, które mogą filtrować toksyny ze środowiska i które są skutkiem ataków wroga.</ToxFiltration.description>
  <!-- EN:
    <li>subject->toxin filtration</li>
    <li>subject->toxin metabolisation</li>
    <li>subject_story->helped milworld combat survivors breathe again</li>
    <li>subject_story->skipped chemistry practicals for extra ethics classes</li>
    <li>subject_story->joined a mine-corp as a filtration specialist</li>
    <li>subject_gerund->metabolising toxins</li>
    <li>subject_gerund->crafting antitoxin organs</li>
  -->
  <ToxFiltration.generalRules.rulesStrings>
    <!-- EN: subject->toxin filtration -->
    <li>subject->filtrowanie toksyn</li>
    <!-- EN: subject->toxin metabolisation -->
    <li>subject->metabolizowanie toksyn</li>
    <!-- EN: subject_story->helped milworld combat survivors breathe again -->
    <li>subject_story->pomaga ocalałym z walk na świecie militarnym odzyskać zdolność swobodnego oddychania</li>
    <!-- EN: subject_story->skipped chemistry practicals for extra ethics classes -->
    <li>subject_story->opuszcza ćwiczenia z chemii, aby uczestniczyć w dodatkowych zajęciach z etyki</li>
    <!-- EN: subject_story->joined a mine-corp as a filtration specialist -->
    <li>subject_story->podejmuje pracę w korporacji górniczej jako specjalista od filtracji</li>
    <!-- EN: subject_gerund->metabolising toxins -->
    <li>subject_gerund->metabolizowanie toksyn</li>
    <!-- EN: subject_gerund->crafting antitoxin organs -->
    <li>subject_gerund->wytwarzanie narządów neutralizujących toksyny</li>
  </ToxFiltration.generalRules.rulesStrings>
  
  <!-- EN: tox gas -->
  <ToxGas.label>toksyczny gaz</ToxGas.label>
  <!-- EN: Produce weapons that utilize caustic tox gas. -->
  <ToxGas.description>Wyprodukuj broń wykorzystującą żrący toksyczny gaz.</ToxGas.description>
  <!-- EN:
    <li>subject->gas weaponry</li>
    <li>subject->chemical warfare</li>
    <li>subject_story->dreamed of a weapon to end all wars</li>
    <li>subject_story->skipped ethics classes for extra chemistry practice</li>
    <li>subject_story->researched cloud control tech for the tyrannocracy of a deathworld</li>
    <li>subject_gerund->crafting toxic gas weapons</li>
  -->
  <ToxGas.generalRules.rulesStrings>
    <!-- EN: subject->gas weaponry -->
    <li>subject->broń gazowa</li>
    <!-- EN: subject->chemical warfare -->
    <li>subject->wojna chemiczna</li>
    <!-- EN: subject_story->dreamed of a weapon to end all wars -->
    <li>subject_story->marzy o stworzeniu broni, która zakończy wszystkie wojny</li>
    <!-- EN: subject_story->skipped ethics classes for extra chemistry practice -->
    <li>subject_story->opuszcza zajęcia z etyki, aby poświęcić więcej czasu na ćwiczenia z chemii</li>
    <!-- EN: subject_story->researched cloud control tech for the tyrannocracy of a deathworld -->
    <li>subject_story->bada technologię kontrolowania chmur dla tyranokracji z martwego świata</li>
    <!-- EN: subject_gerund->crafting toxic gas weapons -->
    <li>subject_gerund->wytwarzanie broni na toksyczny gaz</li>
  </ToxGas.generalRules.rulesStrings>
  
  <!-- EN: toxifier generator -->
  <ToxifierGenerator.label>generator toksyn</ToxifierGenerator.label>
  <!-- EN: Create toxifier generators which generate electricity, but also spread pollution around themselves. -->
  <ToxifierGenerator.description>Twórz generatory toksyn, które wytwarzają prąd, ale także tworzą wokół siebie zanieczyszczenia.</ToxifierGenerator.description>
  <!-- EN:
    <li>subject->toxifier generator</li>
    <li>subject_story->led a clean-up crew to a toxic planetoid</li>
    <li>subject_story->learned about toxifiers in the deep sump of a skyripper</li>
    <li>subject_story->researched cheap and dirty power sources for an urbcorp</li>
    <li>subject_gerund->constructing toxifier generators</li>
  -->
  <ToxifierGenerator.generalRules.rulesStrings>
    <!-- EN: subject->toxifier generator -->
    <li>subject->generator toksyn</li>
    <!-- EN: subject_story->led a clean-up crew to a toxic planetoid -->
    <li>subject_story->prowadzi ekipę oczyszczającą na toksyczną planetoidę</li>
    <!-- EN: subject_story->learned about toxifiers in the deep sump of a skyripper -->
    <li>subject_story->poznaje działanie generatorów toksyn w głębokim zbiorniku ściekowym rozpruwacza nieba</li>
    <!-- EN: subject_story->researched cheap and dirty power sources for an urbcorp -->
    <li>subject_story->bada tanie, lecz zanieczyszczające środowisko źródła energii dla miejskiej korporacji</li>
    <!-- EN: subject_gerund->constructing toxifier generators -->
    <li>subject_gerund->budowa generatorów toksyn</li>
  </ToxifierGenerator.generalRules.rulesStrings>
  
  <!-- EN: xenogenetics -->
  <Xenogermination.label>ksenogenetyka</Xenogermination.label>
  <!-- EN: Create xenogerms which can be implanted in a person to genetically modify them. Extract genepacks from living people using a gene extractor so you can reimplant their genes into someone else. -->
  <Xenogermination.description>Twórz ksenogeny, które można wszczepić człowiekowi w celu jego modyfikacji genetycznej. Wyodrębnij pakiety genów od żywych ludzi za pomocą ekstraktora genów, aby móc ponownie wszczepić ich geny komuś innemu.</Xenogermination.description>
  <!-- EN:
    <li>subject->xenogermination</li>
    <li>subject->genetic implantation</li>
    <li>subject_story->was uplifted by a glitterworld charity that focused on the genetically disadvantaged</li>
    <li>subject_story->had [ANYPAWN_possessive] genes stolen by a rogue biologist</li>
    <li>subject_story->ran a genetic transfer clinic for the glitterworld elite</li>
    <li>subject_gerund->crafting xenogerms</li>
  -->
  <Xenogermination.generalRules.rulesStrings>
    <!-- EN: subject->xenogermination -->
    <li>subject->ksenogenetyka</li>
    <!-- EN: subject->genetic implantation -->
    <li>subject->wszczepianie genów</li>
    <!-- EN: subject_story->was uplifted by a glitterworld charity that focused on the genetically disadvantaged -->
    <li>subject_story->otrzymuje pomoc od organizacji charytatywnej z ultratechnologicznego świata wspierającej osoby z niekorzystnymi cechami genetycznymi</li>
    <!-- EN: subject_story->had [ANYPAWN_possessive] genes stolen by a rogue biologist -->
    <li>subject_story->odkrywa, że nieuczciwy biolog kradnie [ANYPAWN_possessive] geny</li>
    <!-- EN: subject_story->ran a genetic transfer clinic for the glitterworld elite -->
    <li>subject_story->prowadzi klinikę transferu genów dla elit ultratechnologicznego świata</li>
    <!-- EN: subject_gerund->crafting xenogerms -->
    <li>subject_gerund->wytwarzanie ksenogenów</li>
  </Xenogermination.generalRules.rulesStrings>
  
</LanguageData>