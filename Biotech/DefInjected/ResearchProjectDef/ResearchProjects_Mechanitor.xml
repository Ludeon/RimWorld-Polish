<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: basic mechtech -->
  <BasicMechtech.label>podstawowa mechtechnologia</BasicMechtech.label>
  <!-- EN: The technology needed for your mechanitor to create and control basic-tier mechanoids. -->
  <BasicMechtech.description>Technologia potrzebna twojemu mechanitorowi do tworzenia i kontrolowania mechanoidów podstawowego poziomu.</BasicMechtech.description>
  <!-- EN:
    <li>subject->mechanoids</li>
    <li>subject_story->authored a children's book covering the basic types of mechanoid</li>
    <li>subject_story->was implanted with a prototype mechlink</li>
    <li>subject_story->replicated basic biomech techniques independently</li>
    <li>subject_story->was mining an ancient exostrider wreck and found a mechlink preserved in the wreckage</li>
    <li>subject_gerund->creating basic mechanoids</li>
  -->
  <BasicMechtech.generalRules.rulesStrings>
    <!-- EN: subject->mechanoids -->
    <li>subject->mechanoidy</li>
    <!-- EN: subject_story->authored a children's book covering the basic types of mechanoid -->
    <li>subject_story->ma na koncie książkę dla dzieci o podstawowych rodzajach mechanoidów</li>
    <!-- EN: subject_story->was implanted with a prototype mechlink -->
    <li>subject_story->otrzymuje prototypowy mechlink</li>
    <!-- EN: subject_story->replicated basic biomech techniques independently -->
    <li>subject_story->samodzielnie odtwarza podstawowe techniki biomechaniczne</li>
    <!-- EN: subject_story->was mining an ancient exostrider wreck and found a mechlink preserved in the wreckage -->
    <li>subject_story->podczas wydobywania surowców z wraku starożytnego egzokrocznika znajduje zachowany mechlink</li>
    <!-- EN: subject_gerund->creating basic mechanoids -->
    <li>subject_gerund->wytwarzanie podstawowych mechanoidów</li>
  </BasicMechtech.generalRules.rulesStrings>
  
  <!-- EN: high mechtech -->
  <HighMechtech.label>zaawansowana mechtechnologia</HighMechtech.label>
  <!-- EN: The technology needed for your mechanitor to create and control high-tier mechanoids.\n\nYou can get powerfocus chips by using a mechanitor to summon a war queen threat. -->
  <HighMechtech.description>Technologia potrzebna twojemu mechanitorowi do tworzenia i kontrolowania mechanoidów zaawansowanego poziomu.\n\nMożesz zdobyć chipy wspomaganego skupienia za pomocą mechanitora, który w tym celu musi przywołać niebezpiecznego watażkę.</HighMechtech.description>
  <!-- EN:
    <li>subject->high tier mechanoids</li>
    <li>subject_story->survived a War Queen assault on an Imperial world</li>
    <li>subject_story->bought a Powerfocus chip from a trader who didn't understand its worth</li>
    <li>subject_story->interrogated mechanitors captured in planetary raids</li>
    <li>subject_story->built prototype mechanoid micro-organs for an offworld client</li>
    <li>subject_gerund->creating high-tier mechanoids</li>
  -->
  <HighMechtech.generalRules.rulesStrings>
    <!-- EN: subject->high tier mechanoids -->
    <li>subject->zaawansowane mechanoidy</li>
    <!-- EN: subject_story->survived a War Queen assault on an Imperial world -->
    <li>subject_story->przeżywa atak królowej wojny na imperialnym świecie</li>
    <!-- EN: subject_story->bought a Powerfocus chip from a trader who didn't understand its worth -->
    <li>subject_story->kupuje chip wzmacniający od handlarza nieświadomego jego wartości</li>
    <!-- EN: subject_story->interrogated mechanitors captured in planetary raids -->
    <li>subject_story->przesłuchuje mechanitorów pojmanych podczas najazdów na planety</li>
    <!-- EN: subject_story->built prototype mechanoid micro-organs for an offworld client -->
    <li>subject_story->konstruuje prototypowe mikronarządy mechanoidów dla klienta spoza planety</li>
    <!-- EN: subject_gerund->creating high-tier mechanoids -->
    <li>subject_gerund->wytwarzanie zaawansowanych mechanoidów</li>
  </HighMechtech.generalRules.rulesStrings>
  
  <!-- EN: standard mechtech -->
  <StandardMechtech.label>standardowa mechtechnologia</StandardMechtech.label>
  <!-- EN: The technology needed for your mechanitor to create and control standard-tier mechanoids.\n\nYou can get signal chips by using a mechanitor to summon a diabolus threat. -->
  <StandardMechtech.description>Technologia potrzebna twojemu mechanitorowi do tworzenia i kontrolowania mechanoidów standardowego poziomu.\n\nMożesz zdobyć chipy sygnałowe za pomocą mechanitora, który w tym celu musi przywołać niebezpiecznego diabolusa.</StandardMechtech.description>
  <!-- EN:
    <li>subject->mechanoids</li>
    <li>subject_story->acquired a signal chip in shady circumstances</li>
    <li>subject_story->found an intact signal chip in a diabolus wreck</li>
    <li>subject_story->survived a mechanoid hive assault</li>
    <li>subject_story->collated reports of mechanoid attacks, looking for commonalities</li>
    <li>subject_gerund->creating standard mechanoids</li>
  -->
  <StandardMechtech.generalRules.rulesStrings>
    <!-- EN: subject->mechanoids -->
    <li>subject->mechanoidy</li>
    <!-- EN: subject_story->acquired a signal chip in shady circumstances -->
    <li>subject_story->zdobywa chip sygnałowy w podejrzanych okolicznościach</li>
    <!-- EN: subject_story->found an intact signal chip in a diabolus wreck -->
    <li>subject_story->znajduje nienaruszony chip sygnałowy we wraku diabolusa</li>
    <!-- EN: subject_story->survived a mechanoid hive assault -->
    <li>subject_story->przeżywa atak roju mechanoidów</li>
    <!-- EN: subject_story->collated reports of mechanoid attacks, looking for commonalities -->
    <li>subject_story->porównuje doniesienia o atakach mechanoidów w poszukiwaniu wspólnych cech</li>
    <!-- EN: subject_gerund->creating standard mechanoids -->
    <li>subject_gerund->wytwarzanie standardowych mechanoidów</li>
  </StandardMechtech.generalRules.rulesStrings>
  
  <!-- EN: ultra mechtech -->
  <UltraMechtech.label>ultra mechtechnologia</UltraMechtech.label>
  <!-- EN: The advanced technology needed for your mechanitor to create and control ultra-tier mechanoids, including large mechs and ultra-tier mechanitor gear.\n\nYou can get nano structuring chips by using a mechanitor to summon an apocriton threat. -->
  <UltraMechtech.description>Technologia potrzebna twojemu mechanitorowi do tworzenia i kontrolowania mechanoidów ultra poziomu.\n\nMożesz zdobyć chipy nano-strukturujące za pomocą mechanitora, który w tym celu musi przywołać niebezpiecznego apokryta.</UltraMechtech.description>
  <!-- EN:
    <li>subject->ultra-tier mechanoids</li>
    <li>subject_story->found a powered-down apocriton in the wreckage of a deadworld</li>
    <li>subject_story->observed an apocriton resurrecting mechs from a safe distance</li>
    <li>subject_story->tapped into the deep psychic hatred that the apocritons feel towards humanity</li>
    <li>subject_story->found an ascension diary next to an inert archonexus</li>
    <li>subject_gerund->creating ultra-tier mechanoids</li>
  -->
  <UltraMechtech.generalRules.rulesStrings>
    <!-- EN: subject->ultra-tier mechanoids -->
    <li>subject->mechanoidy najwyższej klasy</li>
    <!-- EN: subject_story->found a powered-down apocriton in the wreckage of a deadworld -->
    <li>subject_story->znajduje wyłączonego apokryta w ruinach martwego świata</li>
    <!-- EN: subject_story->observed an apocriton resurrecting mechs from a safe distance -->
    <li>subject_story->z bezpiecznej odległości obserwuje apokryta wskrzeszającego mechy</li>
    <!-- EN: subject_story->tapped into the deep psychic hatred that the apocritons feel towards humanity -->
    <li>subject_story->wykorzystuje głęboką psychiczną nienawiść apokrytów do ludzkości</li>
    <!-- EN: subject_story->found an ascension diary next to an inert archonexus -->
    <li>subject_story->znajduje dziennik wniebowstąpienia obok nieaktywnego archonexusu</li>
    <!-- EN: subject_gerund->creating ultra-tier mechanoids -->
    <li>subject_gerund->wytwarzanie mechanoidów najwyższej klasy</li>
  </UltraMechtech.generalRules.rulesStrings>
  
  <!-- EN: wastepack atomizer -->
  <WastepackAtomizer.label>atomizer odpadów</WastepackAtomizer.label>
  <!-- EN: Build wastepack atomizers which can safely dispose of toxic wastepacks by decomposing them at the molecular level. -->
  <WastepackAtomizer.description>Atomizer odpadów w bezpieczny sposób pozbywają się toksycznych odpadów, rozkładając je na poziomie molekularnym.</WastepackAtomizer.description>
  <!-- EN:
    <li>subject->toxic waste atomization</li>
    <li>subject_story->studied safe atomic waste disposal</li>
    <li>subject_story->recruited disposable teams for solar waste disposal missions</li>
    <li>subject_story->devised the theory for atomic destabilization from first principles</li>
    <li>subject_story->observed a toxicworld from orbit</li>
    <li>subject_gerund->constructing wastepack atomizers</li>
  -->
  <WastepackAtomizer.generalRules.rulesStrings>
    <!-- EN: subject->toxic waste atomization -->
    <li>subject->atomizacja odpadów toksycznych</li>
    <!-- EN: subject_story->studied safe atomic waste disposal -->
    <li>subject_story->bada bezpieczne metody atomowego usuwania odpadów</li>
    <!-- EN: subject_story->recruited disposable teams for solar waste disposal missions -->
    <li>subject_story->rekrutuje zespoły skazane na straty do misji usuwania odpadów na słońcu</li>
    <!-- EN: subject_story->devised the theory for atomic destabilization from first principles -->
    <li>subject_story->opracowuje od podstaw teorię atomowej destabilizacji</li>
    <!-- EN: subject_story->observed a toxicworld from orbit -->
    <li>subject_story->obserwuje toksyczny świat z orbity</li>
    <!-- EN: subject_gerund->constructing wastepack atomizers -->
    <li>subject_gerund->budowa atomizerów odpadów toksycznych</li>
  </WastepackAtomizer.generalRules.rulesStrings>
  
</LanguageData>