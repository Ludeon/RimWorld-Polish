<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN:
    <li>questDescription->[asker_nameFull], [asker_faction_leaderTitle] of [asker_faction_name], has sent us a message. Apparently, [siteFaction_pawnsPlural] based in a nearby camp have been raiding their caravans. The camp is controlled by [siteFaction_name].\n\n[asker_nameDef] is asking us to destroy the camp, which means eliminating all enemies and turrets. [asker_label] says that [sitePart0_description].</li>
  -->
  <OpportunitySite_BanditCamp.questDescriptionRules.rulesStrings>
    <li>questDescription->[asker_nameFull] (tytuł: [asker_faction_leaderTitle], frakcja: [asker_faction_name]) przysyła wiadomość. W pobliskim obozie należącym do frakcji [siteFaction_name] stacjonują napastnicy. Grupa ta, określana jako [siteFaction_pawnsPlural], napada na karawany zleceniodawcy.\n\n[asker_nameDef] prosi o zniszczenie obozu i wyeliminowanie wszystkich przeciwników oraz wieżyczek obronnych. Według otrzymanych informacji [sitePart0_description].</li>
  </OpportunitySite_BanditCamp.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->The [bandit] [camp]</li>
    <li>questName->[bandit] [camp]</li>
    <li>questName->[asker_nameDef] and the [camp]</li>
    <li>camp->Camp</li>
    <li>camp->Outpost</li>
    <li>camp->Lair</li>
    <li>camp->Encampment</li>
    <li>bandit->Bandit</li>
    <li>bandit->Raider</li>
    <li>bandit->Outlaw</li>
    <li>bandit->Desperado</li>
    <li>bandit->Fugitive</li>
    <li>bandit->Marauder</li>
    <li>bandit->Robber</li>
    <li>bandit->Brigand</li>
  -->
  <OpportunitySite_BanditCamp.questNameRules.rulesStrings>
    <li>questName->[camp] [bandit]</li>
    <li>questName->Likwidacja: [camp] [bandit]</li>
    <li>questName->Zlecenie [asker_nameDef]: [camp] [bandit]</li>
    <li>camp->obóz</li>
    <li>camp->placówka</li>
    <li>camp->kryjówka</li>
    <li>camp->obozowisko</li>
    <li>bandit->bandytów</li>
    <li>bandit->najeźdźców</li>
    <li>bandit->banitów</li>
    <li>bandit->desperatów</li>
    <li>bandit->zbiegów</li>
    <li>bandit->rabusiów</li>
    <li>bandit->złodziei</li>
    <li>bandit->rozbójników</li>
  </OpportunitySite_BanditCamp.questNameRules.rulesStrings>
  <!-- EN: Quest expired: [resolvedQuestName] -->
  <OpportunitySite_BanditCamp.LetterLabelQuestExpired.slateRef>Zadanie wygasło: [resolvedQuestName]</OpportunitySite_BanditCamp.LetterLabelQuestExpired.slateRef>
  <!-- EN: The bandit camp has packed up and moved on. The quest [resolvedQuestName] has expired. -->
  <OpportunitySite_BanditCamp.LetterTextQuestExpired.slateRef>Bandyci spakowali się i wyruszyli w dalszą drogę. Zadanie [resolvedQuestName] wygasło.</OpportunitySite_BanditCamp.LetterTextQuestExpired.slateRef>
  <!-- EN: Quest failed: [resolvedQuestName] -->
  <OpportunitySite_BanditCamp.LetterLabelQuestFailed.slateRef>Zadanie nieudane: [resolvedQuestName]</OpportunitySite_BanditCamp.LetterLabelQuestFailed.slateRef>
  <!-- EN: After being discovered, the bandit camp has dispersed. The quest [resolvedQuestName] has ended. -->
  <OpportunitySite_BanditCamp.LetterTextQuestFailed.slateRef>Po odkryciu obóz bandytów został opuszczony, a jego załoga rozproszyła się. Zadanie [resolvedQuestName] zostało zakończone.</OpportunitySite_BanditCamp.LetterTextQuestFailed.slateRef>
  <!-- EN: Payment arrived -->
  <OpportunitySite_BanditCamp.LetterLabelPaymentArrived.slateRef>Zapłata dotarła</OpportunitySite_BanditCamp.LetterLabelPaymentArrived.slateRef>
  <!-- EN: You have defeated the bandit camp!\n\nThe payment from [asker_faction_name] has arrived. -->
  <OpportunitySite_BanditCamp.LetterTextPaymentArrived.slateRef>Obóz bandytów został pokonany!\n\nDotarła zapłata od frakcji [asker_faction_name].</OpportunitySite_BanditCamp.LetterTextPaymentArrived.slateRef>
  <!-- EN: [asker_faction_royalFavorLabel] -->
  <OpportunitySite_BanditCamp.LetterLabelFavorReceiver.slateRef>[asker_faction_royalFavorLabel]</OpportunitySite_BanditCamp.LetterLabelFavorReceiver.slateRef>
  <!-- EN: These colonists participated in the victory for the quest [resolvedQuestName]. [asker_definite] wants to know who should receive the [royalFavorReward_amount] [asker_faction_royalFavorLabel] for this service. -->
  <OpportunitySite_BanditCamp.LetterTextFavorReceiver.slateRef>Ci koloniści przyczynili się do zwycięstwa w zadaniu [resolvedQuestName]. [asker_definite] prosi o wskazanie, komu przyznać nagrodę: [royalFavorReward_amount] [asker_faction_royalFavorLabel].</OpportunitySite_BanditCamp.LetterTextFavorReceiver.slateRef>
  
</LanguageData>