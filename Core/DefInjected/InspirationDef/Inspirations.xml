<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: go frenzy -->
  <Frenzy_Go.label>szał ruchu</Frenzy_Go.label>
  <!-- EN: Inspired: Go frenzy -->
  <Frenzy_Go.baseInspectLine>Inspiracja: szał ruchu</Frenzy_Go.baseInspectLine>
  <!-- EN: [PAWN_pronoun] will move faster for the next 8 days. -->
  <Frenzy_Go.beginLetter>Przez następne 8 dni prędkość poruszania się będzie zwiększona.</Frenzy_Go.beginLetter>
  <Frenzy_Go.beginLetterLabel>Inspiracja - szał ruchu</Frenzy_Go.beginLetterLabel>
  <!-- EN: {0} is no longer inspired (go frenzy). -->
  <Frenzy_Go.endMessage>Koniec inspiracji: szał ruchu ({0}).</Frenzy_Go.endMessage>
  
  <!-- EN: shoot frenzy -->
  <Frenzy_Shoot.label>szał strzelania</Frenzy_Shoot.label>
  <!-- EN: Inspired: Shoot frenzy -->
  <Frenzy_Shoot.baseInspectLine>Inspiracja: szał strzelania</Frenzy_Shoot.baseInspectLine>
  <!-- EN: [PAWN_pronoun] will shoot more accurately for the next 8 days. -->
  <Frenzy_Shoot.beginLetter>Przez następne 8 dni celność strzelania będzie zwiększona.</Frenzy_Shoot.beginLetter>
  <Frenzy_Shoot.beginLetterLabel>Inspiracja - szał strzelania</Frenzy_Shoot.beginLetterLabel>
  <!-- EN: {0} is no longer inspired (shoot frenzy). -->
  <Frenzy_Shoot.endMessage>Koniec inspiracji: szał strzelania ({0}).</Frenzy_Shoot.endMessage>
  
  <!-- EN: work frenzy -->
  <Frenzy_Work.label>szał pracy</Frenzy_Work.label>
  <!-- EN: Inspired: Work frenzy -->
  <Frenzy_Work.baseInspectLine>Inspiracja: szał pracy</Frenzy_Work.baseInspectLine>
  <!-- EN: [PAWN_pronoun] will work faster for the next 8 days. -->
  <Frenzy_Work.beginLetter>Przez następne 8 dni tempo pracy będzie zwiększone.</Frenzy_Work.beginLetter>
  <Frenzy_Work.beginLetterLabel>Inspiracja - szał pracy</Frenzy_Work.beginLetterLabel>
  <!-- EN: {0} is no longer inspired (work frenzy). -->
  <Frenzy_Work.endMessage>Koniec inspiracji: szał pracy ({0}).</Frenzy_Work.endMessage>
  
  <!-- EN: inspired creativity -->
  <Inspired_Creativity.label>inspiracja sztuką</Inspired_Creativity.label>
  <!-- EN: Inspired: Inspired creativity -->
  <Inspired_Creativity.baseInspectLine>Inspiracja: twórczość</Inspired_Creativity.baseInspectLine>
  <!-- EN: The next item, art, or furniture [PAWN_pronoun] creates will be two quality levels higher than it would otherwise be. This even allows the creation of legendary items.\n\nThe inspiration will end after 8 days, or when the creation is completed. -->
  <Inspired_Creativity.beginLetter>Następny wykonany przedmiot, dzieło sztuki lub mebel będzie mieć jakość wyższą o dwa poziomy niż zwykle. Pozwala to nawet osiągnąć legendarną jakość.\n\nInspiracja zakończy się po 8 dniach lub po wykonaniu przedmiotu.</Inspired_Creativity.beginLetter>
  <Inspired_Creativity.beginLetterLabel>Inspiracja - twórczość</Inspired_Creativity.beginLetterLabel>
  <!-- EN: {0} is no longer inspired (inspired creativity). -->
  <Inspired_Creativity.endMessage>Koniec inspiracji: twórczość ({0}).</Inspired_Creativity.endMessage>
  
  <!-- EN: inspired recruitment -->
  <Inspired_Recruitment.label>inspiracja rekrutacją</Inspired_Recruitment.label>
  <!-- EN: Inspired: Inspired recruitment -->
  <Inspired_Recruitment.baseInspectLine>Inspiracja: rekrutacja</Inspired_Recruitment.baseInspectLine>
  <!-- EN: [PAWN_pronoun] will successfully recruit the next prisoner regardless of difficulty or resistance, as long as they are not unwaveringly loyal.\n\nThe inspiration will end after 8 days, or when the prisoner is recruited. -->
  <Inspired_Recruitment.beginLetter>Następna próba rekrutacji więźnia zakończy się powodzeniem niezależnie od trudności i oporu, o ile więzień nie jest niezłomnie lojalny.\n\nInspiracja zakończy się po 8 dniach lub po zrekrutowaniu więźnia.</Inspired_Recruitment.beginLetter>
  <Inspired_Recruitment.beginLetterLabel>Inspiracja - rekrutacja</Inspired_Recruitment.beginLetterLabel>
  <!-- EN: {0} is no longer inspired (inspired recruitment). -->
  <Inspired_Recruitment.endMessage>Koniec inspiracji: rekrutacja ({0}).</Inspired_Recruitment.endMessage>
  
  <!-- EN: inspired surgery -->
  <Inspired_Surgery.label>inspiracja chirurgią</Inspired_Surgery.label>
  <!-- EN: Inspired: Inspired surgery -->
  <Inspired_Surgery.baseInspectLine>Inspiracja: chirurgia</Inspired_Surgery.baseInspectLine>
  <!-- EN: The next time [PAWN_pronoun] performs a surgery, [PAWN_possessive] chance of success will be doubled. A small minimum chance of failure still applies.\n\nThe inspiration will end after 8 days, or when the surgery is performed. -->
  <Inspired_Surgery.beginLetter>Podczas następnej operacji szansa na powodzenie będzie dwukrotnie wyższa. Nadal pozostanie niewielkie ryzyko niepowodzenia.\n\nInspiracja zakończy się po 8 dniach lub po przeprowadzeniu operacji.</Inspired_Surgery.beginLetter>
  <Inspired_Surgery.beginLetterLabel>Inspiracja - chirurgia</Inspired_Surgery.beginLetterLabel>
  <!-- EN: {0} is no longer inspired (inspired surgery). -->
  <Inspired_Surgery.endMessage>Koniec inspiracji: chirurgia ({0}).</Inspired_Surgery.endMessage>
  
  <!-- EN: inspired taming -->
  <Inspired_Taming.label>Inspiracja oswajaniem</Inspired_Taming.label>
  <!-- EN: Inspired: Inspired taming -->
  <Inspired_Taming.baseInspectLine>Inspiracja: oswajanie</Inspired_Taming.baseInspectLine>
  <!-- EN: [PAWN_pronoun] will successfully tame the next animal regardless of difficulty.\n\nThe inspiration will end after 8 days, or when an animal was tamed. -->
  <Inspired_Taming.beginLetter>Następna próba oswojenia zwierzęcia zakończy się powodzeniem niezależnie od trudności.\n\nInspiracja zakończy się po 8 dniach lub po oswojeniu zwierzęcia.</Inspired_Taming.beginLetter>
  <!-- EN: {0} is no longer inspired (inspired taming). -->
  <Inspired_Taming.endMessage>Koniec inspiracji: oswajanie ({0}).</Inspired_Taming.endMessage>
  
  <!-- EN: inspired trade -->
  <Inspired_Trade.label>inspiracja handlem</Inspired_Trade.label>
  <!-- EN: Inspired: Inspired trade -->
  <Inspired_Trade.baseInspectLine>Inspiracja: handel</Inspired_Trade.baseInspectLine>
  <!-- EN: [PAWN_pronoun] will get a significant trade price bonus when closing [PAWN_possessive] next trade deal.\n\nThe inspiration will expire after 8 days, or when the deal is done. -->
  <Inspired_Trade.beginLetter>Następna transakcja handlowa zapewni znaczną premię do cen.\n\nInspiracja wygaśnie po 8 dniach lub po zawarciu transakcji.</Inspired_Trade.beginLetter>
  <Inspired_Trade.beginLetterLabel>Inspiracja - handel</Inspired_Trade.beginLetterLabel>
  <!-- EN: {0} is no longer inspired (inspired trade). -->
  <Inspired_Trade.endMessage>Koniec inspiracji: handel ({0}).</Inspired_Trade.endMessage>
  
